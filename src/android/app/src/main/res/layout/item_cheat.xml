<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/EdenCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="1.5dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkbox_cheat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:layout_marginEnd="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_cheat_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Infinite Health"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:maxLines="1" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_build_id_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Build: A1B2C3"
                    android:textSize="8sp"
                    android:textColor="?attr/colorPrimary"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:background="@drawable/badge_pill_blue"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_cheat_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ В игре"
                    android:textSize="9sp"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_cheat_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Описание"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_code_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="04000000 01234567 00000001"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_value"
            style="@style/EdenButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"
            android:text="✏️ Кол-во"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:backgroundTint="?attr/colorSurfaceVariant"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            app:cornerRadius="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="4dp"
            android:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
