<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/layout_profiles_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/storm_tile_3d_recessed"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/image_profiles_header_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder_open"
                app:tint="?attr/colorPrimary"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_profiles_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/storm_prof_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

                <TextView
                    android:id="@+id/text_profiles_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_storm_badge_capsule"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="4"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_profiles_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Готовых пресетов: 4 • Пользовательских: 0"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />
        </LinearLayout>

        <!-- Top Header Action Buttons: Save & Import (Stacked Vertically) & Close -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_current_profile"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/storm_btn_3d_secondary"
                app:backgroundTint="@null"
                app:strokeWidth="0dp"
                android:text="@string/storm_prof_btn_save"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11.5sp"
                app:icon="@drawable/ic_add"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconTint="?attr/colorPrimary"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:ellipsize="none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_profile"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/storm_btn_3d_secondary"
                app:backgroundTint="@null"
                app:strokeWidth="0dp"
                android:text="@string/storm_prof_btn_import"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11.5sp"
                app:icon="@drawable/ic_import"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconTint="?attr/colorPrimary"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:ellipsize="none" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_profiles"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/storm_btn_3d_secondary"
            android:contentDescription="@string/close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_clear"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <!-- Filter Chips + Search Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <!-- Category Filter Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:checked="true"
                android:text="@string/storm_prof_filter_all"
                android:textSize="12sp"
                app:strokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_presets"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/storm_prof_filter_presets"
                android:textSize="12sp"
                app:strokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_custom"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/storm_prof_filter_custom"
                android:textSize="12sp"
                app:strokeWidth="0dp" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_search_profile"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/storm_prof_search_hint"
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="?attr/colorOnSurfaceVariant"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_search_profile"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Profiles RecyclerView & Empty State Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_profiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/text_empty_profiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/storm_prof_empty_search"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none" />

    </FrameLayout>

</LinearLayout>
