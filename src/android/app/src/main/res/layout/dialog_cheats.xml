<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/card_root_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_code"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_dialog_title"
                    style="@style/SynthwaveText.Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cheats_manager_title"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_game_info"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Title ID: 0000000000000000"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/storm_btn_3d_secondary"
                android:elevation="2dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_clear"
                app:tint="?attr/colorOnSurface" />

        </LinearLayout>

        <!-- Search Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_search"
            style="@style/StormCard"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorSecondary"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/edit_search_cheats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:background="@drawable/storm_input_3d"
                    android:hint="@string/cheats_search_hint"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:hyphenationFrequency="none"
                    android:breakStrategy="simple"
                    android:inputType="text" />

                <ImageView
                    android:id="@+id/btn_clear_search"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:background="?attr/selectableItemBackgroundBorderless" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:id="@+id/layout_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_download_online"
                style="@style/StormButton.Faceted.Secondary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="36dp"
                android:text="@string/download_cheats"
                android:maxLines="1"
                android:ellipsize="none"
                android:hyphenationFrequency="none"
                android:breakStrategy="simple"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:backgroundTint="?attr/colorSurfaceVariant"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                app:icon="@drawable/ic_import"
                app:iconTint="?attr/colorPrimary"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_custom_cheat"
                style="@style/StormButton.Faceted.Secondary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:minHeight="36dp"
                android:text="@string/add_cheat"
                android:maxLines="1"
                android:ellipsize="none"
                android:hyphenationFrequency="none"
                android:breakStrategy="simple"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:backgroundTint="?attr/colorSurfaceVariant"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                app:icon="@drawable/ic_add"
                app:iconTint="?attr/colorPrimary"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_all"
                style="@style/StormButton.Faceted.Secondary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="36dp"
                android:text="@string/select_all"
                android:maxLines="1"
                android:ellipsize="none"
                android:hyphenationFrequency="none"
                android:breakStrategy="simple"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeMaxTextSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:backgroundTint="?attr/colorSurfaceVariant"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp" />

        </LinearLayout>

        <!-- Download Status Indicator -->
        <LinearLayout
            android:id="@+id/layout_download_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorSurfaceVariant">

            <ProgressBar
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_download_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloading_cheats"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

        </LinearLayout>

        <!-- Cheats List / Empty View Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_cheats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_cheat" />

            <LinearLayout
                android:id="@+id/layout_empty_cheats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_code"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cheats_not_found"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

            </LinearLayout>

        </FrameLayout>

        <!-- Bottom Footer -->
        <LinearLayout
            android:id="@+id/layout_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_cheats_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cheats_summary_zero"
                android:textSize="10.5sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_cheats"
                style="@style/StormButton.Faceted.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:text="@string/ok"
                android:textSize="11sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeWidth="0dp"
                app:strokeColor="?attr/colorPrimary"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:ellipsize="none" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
