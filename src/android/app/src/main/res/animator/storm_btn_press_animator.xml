<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state: tactile compression and bevel depression -->
    <item android:state_pressed="true" android:state_enabled="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="100"
                android:valueTo="0.955"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="100"
                android:valueTo="0.955"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator
                android:propertyName="translationY"
                android:duration="100"
                android:valueTo="3.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="100"
                android:valueTo="2.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </set>
    </item>

    <!-- Default enabled state: full volumetric elevation -->
    <item android:state_enabled="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="160"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/overshoot" />
            <objectAnimator
                android:propertyName="translationY"
                android:duration="160"
                android:valueTo="0.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="160"
                android:valueTo="6.0"
                android:valueType="floatType"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </set>
    </item>

    <!-- Disabled state -->
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="100"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="100"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationY"
                android:duration="100"
                android:valueTo="0.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="100"
                android:valueTo="0.0"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
