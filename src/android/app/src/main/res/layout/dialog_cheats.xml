<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_code"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_dialog_title"
                    style="@style/SynthwaveText.Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cheats_manager_title"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_game_info"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Title ID: 0000000000000000"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Search Bar & Actions in a single/compact row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/EdenCard"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1.4"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorSecondary"
                        android:layout_marginEnd="4dp" />

                    <EditText
                        android:id="@+id/edit_search_cheats"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Поиск..."
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:maxLines="1"
                        android:inputType="text" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_clear"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_download_online"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:text="@string/download_cheats"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:backgroundTint="?attr/colorSurfaceVariant"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_import"
                app:iconTint="?attr/colorPrimary"
                app:iconSize="12dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_custom_cheat"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:text="@string/add_cheat"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:backgroundTint="?attr/colorSurfaceVariant"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_add"
                app:iconTint="?attr/colorPrimary"
                app:iconSize="12dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_all"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:text="@string/select_all"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:backgroundTint="?attr/colorSurfaceVariant"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

        <!-- Download Status Indicator -->
        <LinearLayout
            android:id="@+id/layout_download_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorSurfaceVariant">

            <ProgressBar
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_download_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloading_cheats"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <!-- Cheats List / Empty View Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_cheats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_cheat" />

            <LinearLayout
                android:id="@+id/layout_empty_cheats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_code"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cheats_not_found"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </FrameLayout>

        <!-- Bottom Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_cheats_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Всего читов: 0 | Включено: 0"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_cheats"
                style="@style/EdenButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minHeight="0dp"
                android:text="@string/ok"
                android:textSize="11sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
