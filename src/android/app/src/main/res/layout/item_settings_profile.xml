<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_profile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Icon Tile + Title/Desc Column + Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/frame_profile_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/storm_tile_3d_recessed"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/image_profile_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorPrimary"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_profile_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Profile Name"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/text_profile_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_storm_badge_capsule"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/storm_prof_badge_preset"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none" />

                    <TextView
                        android:id="@+id/text_profile_active_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_storm_badge_capsule"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:text="@string/profile_active_badge"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_profile_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Profile Description"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

            </LinearLayout>

        </LinearLayout>

        <!-- Grouped Parameter Tags Row (Summary Pills) -->
        <LinearLayout
            android:id="@+id/layout_profile_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tag_profile_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_storm_badge_capsule"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="1.0X"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

            <TextView
                android:id="@+id/tag_profile_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_storm_badge_capsule"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:text="Асинхр. шейдеры"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

            <TextView
                android:id="@+id/tag_profile_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_storm_badge_capsule"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:text="GPU: Нормально"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

            <TextView
                android:id="@+id/tag_profile_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_storm_badge_capsule"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="ОЗУ: 4 ГБ"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

        </LinearLayout>

        <!-- Profile Actions Row -->
        <LinearLayout
            android:id="@+id/layout_profile_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Primary 3D Apply Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_apply"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/storm_btn_3d_primary"
                app:backgroundTint="@null"
                app:strokeWidth="0dp"
                android:text="@string/storm_prof_btn_apply"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_check"
                app:iconSize="16dp"
                app:iconTint="#FFFFFF"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:ellipsize="none" />

            <!-- Preset Action: Duplicate Button -->
            <LinearLayout
                android:id="@+id/layout_preset_actions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_duplicate"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/storm_btn_3d_secondary"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp"
                    android:text="@string/storm_prof_btn_duplicate"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_copy"
                    app:iconSize="16dp"
                    app:iconTint="?attr/colorPrimary"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

            </LinearLayout>

            <!-- Custom Actions: Share, Rename, Delete Buttons -->
            <LinearLayout
                android:id="@+id/layout_custom_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_share"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/storm_btn_3d_secondary"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp"
                    android:text="@string/storm_prof_btn_share"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11.5sp"
                    app:icon="@drawable/ic_share"
                    app:iconSize="15dp"
                    app:iconTint="?attr/colorPrimary"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_rename"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/storm_btn_3d_secondary"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp"
                    android:text="@string/storm_prof_btn_rename"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11.5sp"
                    app:icon="@drawable/ic_edit"
                    app:iconSize="15dp"
                    app:iconTint="?attr/colorPrimary"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_profile_delete"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:paddingHorizontal="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:background="@drawable/storm_btn_3d_secondary"
                    app:backgroundTint="@null"
                    app:strokeWidth="0dp"
                    android:text="@string/storm_prof_btn_delete"
                    android:textColor="?attr/colorError"
                    android:textSize="11.5sp"
                    app:icon="@drawable/ic_delete"
                    app:iconSize="15dp"
                    app:iconTint="#EF4444"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
