<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#35FFFFFF">
    <item>
        <selector>
            <!-- 1. Pressed state: 3D Bevel depressed (shifts down by 2dp) -->
            <item android:state_pressed="true" android:state_enabled="true">
                <layer-list>
                    <!-- Bottom Bevel Base (compressed) -->
                    <item android:top="2dp" android:bottom="0dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="14dp" />
                            <solid android:color="#05040B" />
                        </shape>
                    </item>
                    <!-- Main Convex Gradient Body -->
                    <item android:top="2dp" android:bottom="1dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="13dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#221B3B"
                                android:endColor="#0F0C1E"
                                android:type="linear" />
                            <stroke
                                android:width="1.2dp"
                                android:color="#558B5CF6" />
                        </shape>
                    </item>
                    <!-- Specular highlight (subtle) -->
                    <item android:top="2dp" android:bottom="1dp" android:left="3dp" android:right="3dp">
                        <shape android:shape="rectangle">
                            <corners
                                android:topLeftRadius="12dp"
                                android:topRightRadius="12dp"
                                android:bottomLeftRadius="6dp"
                                android:bottomRightRadius="6dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#20FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:type="linear" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- 2. Disabled state -->
            <item android:state_enabled="false">
                <layer-list>
                    <item android:top="0dp" android:bottom="2dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="14dp" />
                            <solid android:color="#1F1A2E" />
                            <stroke
                                android:width="1dp"
                                android:color="#334155" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- 3. Normal / Raised state: 3D Faceted Convex Dome -->
            <item>
                <layer-list>
                    <!-- Bottom 3D Bevel Base (3dp facet depth) -->
                    <item android:top="0dp" android:bottom="0dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="14dp" />
                            <solid android:color="#090714" />
                        </shape>
                    </item>
                    <!-- Main Convex Gradient Body (raised 3dp above bottom base) -->
                    <item android:top="0dp" android:bottom="3dp">
                        <shape android:shape="rectangle">
                            <corners android:radius="13dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#2D254C"
                                android:centerColor="#1D1836"
                                android:endColor="#130F26"
                                android:type="linear" />
                            <stroke
                                android:width="1.2dp"
                                android:color="#558B5CF6" />
                        </shape>
                    </item>
                    <!-- Top Specular Highlight Strip (crystal facet shine) -->
                    <item android:top="1dp" android:bottom="4dp" android:left="3dp" android:right="3dp">
                        <shape android:shape="rectangle">
                            <corners
                                android:topLeftRadius="12dp"
                                android:topRightRadius="12dp"
                                android:bottomLeftRadius="6dp"
                                android:bottomRightRadius="6dp" />
                            <gradient
                                android:angle="270"
                                android:startColor="#38FFFFFF"
                                android:centerColor="#15FFFFFF"
                                android:endColor="#00FFFFFF"
                                android:type="linear" />
                        </shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
