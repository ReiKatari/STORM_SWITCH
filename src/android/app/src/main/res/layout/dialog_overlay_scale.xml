<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Control Title -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dialogTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/emulation_control_adjust"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>

        <!-- Scale Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emulation_control_scale"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/scaleValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:textStyle="bold"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/scaleSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="4.0"
            android:stepSize="0.1"
            android:value="1.0"
            android:layout_marginBottom="8dp"
            app:trackColorActive="#00D2FF"
            app:thumbColor="#00D2FF"
            app:trackColorInactive="#334155" />

        <!-- Opacity Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/emulation_control_opacity"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/opacityValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/opacitySlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="1.0"
            android:stepSize="0.05"
            android:value="1.0"
            android:layout_marginBottom="14dp"
            app:trackColorActive="#00D2FF"
            app:thumbColor="#00D2FF"
            app:trackColorInactive="#334155" />

        <!-- Buttons row: strictly 1 row, each width 0dp weight 1, compact padding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Reset & Cancel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:hyphenationFrequency="none"
                    android:breakStrategy="simple"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="12sp"
                    android:text="@string/reset"
                    app:cornerRadius="8dp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1E293B"
                    app:strokeWidth="0dp"
                    app:strokeColor="?attr/colorOutline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:hyphenationFrequency="none"
                    android:breakStrategy="simple"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="12sp"
                    android:text="@android:string/cancel"
                    app:cornerRadius="8dp"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#334155"
                    app:strokeWidth="0dp"
                    app:strokeColor="?attr/colorOutline" />

            </LinearLayout>

            <!-- Row 2: Confirm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:ellipsize="none"
                android:hyphenationFrequency="none"
                android:breakStrategy="simple"
                android:text="@string/confirm"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                android:textColor="#0F172A"
                android:textStyle="bold"
                app:backgroundTint="#00D2FF"
                app:strokeWidth="0dp"
                app:strokeColor="?attr/colorOutline" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
