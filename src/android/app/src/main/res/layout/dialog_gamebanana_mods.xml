<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <!-- View Switcher Tabs: Online vs Installed -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_tab_switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="#131926"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        app:strokeColor="#25354C"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:id="@+id/layout_tab_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_tab_online"
                style="@style/EdenButton.Primary"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="@string/gamebanana_tab_online"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#00D2FF"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_tab_installed"
                style="@style/EdenButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="@string/gamebanana_tab_installed"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#25354C"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ========================================== -->
    <!-- 1. Online GameBanana Catalog Container      -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layout_online_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_search"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="#00D2FF"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintTextColor="#00D2FF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/gamebanana_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingVertical="8dp"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_search"
                style="@style/EdenButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="@string/search"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#00D2FF"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp"
            android:paddingHorizontal="2dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/SynthwaveText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sort_by"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/spinner_sort"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_rounded" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_manual_install"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:text="@string/gamebanana_install_manual"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_install"
                app:iconSize="14dp" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@color/eden_card_stroke"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_mods"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                tools:listitem="@layout/list_item_gamebanana_mod" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_empty_mods"
                style="@style/SynthwaveText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/gamebanana_no_mods"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Pagination Toolbar -->
        <LinearLayout
            android:id="@+id/layout_pagination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="1dp"
            android:paddingHorizontal="4dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_status"
                style="@style/SynthwaveText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:textSize="11sp"
                android:alpha="0.8"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Страница 1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_first_page"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&lt;&lt;"
                    android:textSize="10sp"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_prev_page"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginStart="4dp"
                    android:padding="0dp"
                    android:text="&lt;"
                    android:textSize="10sp"
                    android:enabled="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_page_indicator"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="@string/page_1"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_next_page"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&gt;"
                    android:textSize="10sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_close"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="@string/close"
                    android:textSize="10sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ========================================== -->
    <!-- 2. Installed Mods Container                 -->
    <!-- ========================================== -->
    <LinearLayout
        android:id="@+id/layout_installed_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="2dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_installed_status"
                style="@style/SynthwaveText.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gamebanana_no_installed_mods"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_refresh_installed"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:text="🔄"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_manual_install_installed"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:text="@string/gamebanana_install_manual"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_install"
                app:iconSize="14dp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_installed_mods"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                tools:listitem="@layout/list_item_addon" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_empty_installed"
                style="@style/SynthwaveText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/gamebanana_no_installed_mods"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Installed Bottom Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="1dp"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_close_installed"
                style="@style/EdenButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="@string/close"
                android:textSize="10sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
