<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/card_root_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/layout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_amiibo"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@string/amiibo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/amiibo"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_game_title"
                    style="@style/SynthwaveText.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/colorPrimary"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:text="The Legend of Zelda: Tears of the Kingdom"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/button_close_top"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/storm_btn_3d_secondary"
                android:elevation="2dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_clear"
                app:tint="?attr/colorOnSurface" />

        </LinearLayout>

        <!-- Active Amiibo Status Card (visible during emulation) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_active_amiibo"
            style="@style/EdenCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="0dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_amiibo"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/amiibo" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_active_amiibo_status"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    tools:text="Активен: Mario (Super Smash Bros.)"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_disconnect_amiibo"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:text="@string/amiibo_disconnect_button"
                    android:textColor="?attr/colorError"
                    app:strokeColor="?attr/colorError"
                    app:strokeWidth="0dp"
                    app:cornerRadius="6dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- View Switcher Tabs: Catalog vs Installed -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_tab_switcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/layout_tab_switcher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="3dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_tab_catalog"
                    style="@style/EdenButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:minHeight="36dp"
                    android:text="@string/amiibo_tab_catalog"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_tab_installed"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:minHeight="36dp"
                    android:text="@string/amiibo_tab_installed"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"
                    app:strokeColor="?attr/colorOutline"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 1. Catalog Container -->
        <LinearLayout
            android:id="@+id/layout_catalog_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_search"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="?attr/colorSurfaceVariant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="?attr/colorPrimary"
                    app:endIconMode="clear_text"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxStrokeColor="?attr/colorPrimary"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintTextColor="?attr/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"

                        android:hint="@string/search_amiibo_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingVertical="8dp"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_refresh"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="36dp"
                    android:text="@string/refresh"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeWidth="0dp"
                    app:strokeColor="?attr/colorOutline"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="14dp"
                    app:iconTint="?attr/colorPrimary"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="3dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_series"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true" />

            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_amiibo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    tools:listitem="@layout/list_item_amiibo" />

                <ProgressBar
                    android:id="@+id/progress_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_empty_amiibo"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/no_amiibo_found"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

            </FrameLayout>

            <!-- Pagination & Status Toolbar -->
            <LinearLayout
                android:id="@+id/layout_pagination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="1dp"
                android:paddingHorizontal="4dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_status"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Всего: 850"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_first_page"
                        style="@style/EdenButton.Outlined"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:padding="0dp"
                        android:text="&lt;&lt;"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="?attr/colorOutline"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:maxLines="1"
                        android:ellipsize="none" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_prev_page"
                        style="@style/EdenButton.Outlined"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:layout_marginStart="4dp"
                        android:padding="0dp"
                        android:text="&lt;"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="?attr/colorOutline"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:maxLines="1"
                        android:ellipsize="none" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/text_page_indicator"
                        style="@style/SynthwaveText.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="@string/page_1"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_next_page"
                        style="@style/EdenButton.Outlined"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="36dp"
                        android:minHeight="36dp"
                        android:padding="0dp"
                        android:text="&gt;"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="6dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="?attr/colorOutline"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:maxLines="1"
                        android:ellipsize="none" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_close"
                        style="@style/EdenButton.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="0dp"
                        android:text="@string/close"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="?attr/colorOutline"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:maxLines="1"
                        android:ellipsize="none" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 2. Installed Amiibo Container -->
        <LinearLayout
            android:id="@+id/layout_installed_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_installed_amiibo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    tools:listitem="@layout/list_item_installed_amiibo" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_empty_installed"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/no_installed_amiibo_found"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="4dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_installed_status"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Установлено: 12 Amiibo"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_refresh_installed"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="@string/refresh"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    app:cornerRadius="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="14dp"
                    app:iconTint="?attr/colorPrimary"
                    app:strokeWidth="0dp"
                    app:strokeColor="?attr/colorOutline"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_close_installed"
                    style="@style/EdenButton.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="@string/close"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeWidth="0dp"
                    app:strokeColor="?attr/colorOutline"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="1"
                    android:ellipsize="none" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
