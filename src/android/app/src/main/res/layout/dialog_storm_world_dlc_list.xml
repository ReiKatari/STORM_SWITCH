<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#0F172A"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeColor="#00D2FF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <!-- Dialog Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161F36"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_install"
                app:tint="#10B981" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Дополнения"
                        android:textColor="#F1F5F9"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_dlc_dialog_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/badge_pill_emerald"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="6 DLC" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_dlc_dialog_game_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    tools:text="Dave the Diver" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_dlc_dialog"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Закрыть"
                android:src="@drawable/ic_clear"
                app:tint="#94A3B8" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#20354E" />

        <!-- Subtitle Info Bar -->
        <TextView
            android:id="@+id/text_dlc_dialog_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0B1322"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Официальные дополнения и контент, включённые в комплект игры"
            android:textColor="#38BDF8"
            android:textSize="11sp" />

        <!-- Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_dlc_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:maxHeight="380dp"
                android:nestedScrollingEnabled="true" />

            <ProgressBar
                android:id="@+id/progress_dlc_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="32dp"
                android:indeterminateTint="#10B981"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_dlc_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="32dp"
                android:text="Список дополнений пуст"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ok_dlc_dialog"
            style="@style/EdenButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="Понятно"
            android:textColor="#0A0E17"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#00D2FF"
            app:cornerRadius="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
