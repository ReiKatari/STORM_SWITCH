<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_log"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_dialog_title"
                    style="@style/SynthwaveText.Header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/log_viewer_title"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_log_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:text="Diablo II | 0100726014352000 | ⚡ В игре"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_log"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="18dp"
                        android:layout_marginEnd="4dp"
                        android:tooltipText="@string/storm_sync_refresh"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:iconTint="?attr/colorPrimary"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorPrimary"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:maxLines="1"
    android:ellipsize="none"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_log"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:icon="@drawable/ic_copy"
                        app:iconSize="18dp"
                        android:layout_marginEnd="4dp"
                        android:tooltipText="@string/storm_sync_copy"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:iconTint="#FEB2B2"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:maxLines="1"
    android:ellipsize="none"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_log"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:icon="@drawable/ic_save"
                        app:iconSize="18dp"
                        android:layout_marginEnd="4dp"
                        android:tooltipText="@string/log_viewer_save_file"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:iconTint="#4FD1C5"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:maxLines="1"
    android:ellipsize="none"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_share_log"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:icon="@drawable/ic_share"
                        app:iconSize="18dp"
                        android:layout_marginEnd="4dp"
                        android:tooltipText="@string/log_viewer_share"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:iconTint="#F6E05E"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:maxLines="1"
    android:ellipsize="none"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_close"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        app:icon="@drawable/ic_clear"
                        app:iconSize="18dp"
                        android:tooltipText="@string/storm_sync_close"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:iconTint="#FFFFFF"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutline"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:maxLines="1"
    android:ellipsize="none"/>

                </LinearLayout>

            </HorizontalScrollView>
        </LinearLayout>



        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/eden_card_background"
            android:paddingHorizontal="10dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/edit_search_log"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:background="@android:color/transparent"
                android:hint="@string/log_viewer_search_hint"
                android:textColor="#FFFFFF"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:inputType="text"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btn_clear_search"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_clear"
                app:tint="?attr/colorPrimary"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Filter Category Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="6dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/log_viewer_chip_all"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_errors"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_viewer_chip_errors"
                    android:textColor="#FF6B6B"
                    android:textSize="11sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_warnings"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_viewer_chip_warnings"
                    android:textColor="#FFD166"
                    android:textSize="11sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_info"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/log_viewer_chip_info"
                    android:textColor="#4FD1C5"
                    android:textSize="11sp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Log Content Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:padding="8dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_log_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10.5sp"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true"
                    tools:text="[ 0.000000] Frontend [Info] Emulator initialized..."
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer / Action bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_log_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                tools:text="Строк: 450 | Размер: 32 КБ"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_messenger"

                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Telegram / MAX"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                app:icon="@drawable/ic_share"
                app:iconSize="14dp"
                app:iconTint="?attr/colorPrimary"
                app:backgroundTint="?attr/colorSurfaceVariant"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorPrimary"
    android:breakStrategy="simple"
    android:hyphenationFrequency="none"
    android:maxLines="1"
    android:ellipsize="none"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>

