<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_profile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="#358B5CF6"
    app:cardBackgroundColor="#1A1530">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Icon + Name & Status + Apply Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/storm_tile_3d_recessed"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/image_profile_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="#C084FC" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_profile_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Profile Name"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="3" />

                    <TextView
                        android:id="@+id/text_profile_active_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_storm_badge_capsule"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="@string/profile_active_badge"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_profile_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Profile Description"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:maxLines="3" />

            </LinearLayout>

            <!-- Apply 3D Faceted Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_apply"
                style="@style/StormButton.3D.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            android:minHeight="44dp"
                android:paddingHorizontal="14dp"
                android:text="@string/profile_btn_apply"
                android:textSize="12sp"
                app:icon="@drawable/ic_check"
                app:iconTint="#FFFFFF"
                app:iconSize="16dp" />

        </LinearLayout>

        <!-- Custom Profile Actions: Clean Responsive 3D Buttons (Zero awkward wrapping) -->
        <LinearLayout
            android:id="@+id/layout_custom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_share"
                style="@style/StormButton.3D.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
            android:minHeight="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/profile_btn_share"
                android:textSize="11sp"
                app:icon="@drawable/ic_share"
                app:iconTint="#FFFFFF"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_rename"
                style="@style/StormButton.3D.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
            android:minHeight="40dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="@string/profile_btn_rename"
                android:textSize="11sp"
                app:icon="@drawable/ic_edit"
                app:iconTint="#CBD5E1"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_delete"
                style="@style/StormButton.3D.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
            android:minHeight="40dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/profile_btn_delete"
                android:textSize="11sp"
                app:icon="@drawable/ic_delete"
                app:iconTint="#FFFFFF"
                app:iconSize="14dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
