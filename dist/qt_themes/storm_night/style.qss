/*
 * STORM NIGHT Stylesheet - Premium OLED Black & Electric Cyan Theme
 * Exclusively for STORM SWITCH 3
 */

QWidget {
    color: #ffffff;
    background-color: #FFFFFF;
    font-family: "Segoe UI", "Outfit", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 9pt;
    outline: none;
    border: none;
}

QWidget:disabled {
    color: #FFFFFF;
    background-color: #040405;
}

QLabel {
    background: transparent;
    background-color: transparent;
    color: #ffffff;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: #ffffff;
    spacing: 8px;
    padding: 3px;
    font-weight: 500;
}

QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator,
QTreeView::indicator, QTableView::indicator, QListView::indicator, QAbstractItemView::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1.5px solid #2a2d3d;
    background-color: #08080c;
    image: none;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover, QGroupBox::indicator:hover,
QTreeView::indicator:hover, QTableView::indicator:hover, QListView::indicator:hover, QAbstractItemView::indicator:hover {
    border-color: #00f2fe;
    background-color: #141824;
    image: none;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked, QGroupBox::indicator:checked,
QTreeView::indicator:checked, QTableView::indicator:checked, QListView::indicator:checked, QAbstractItemView::indicator:checked {
    background-color: #00f2fe;
    border: 1.5px solid #00f2fe;
    image: none;
}

QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover, QGroupBox::indicator:checked:hover,
QTreeView::indicator:checked:hover, QTableView::indicator:checked:hover, QListView::indicator:checked:hover, QAbstractItemView::indicator:checked:hover {
    background-color: #38f8ff;
    border-color: #38f8ff;
    image: none;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled, QGroupBox::indicator:disabled,
QTreeView::indicator:disabled, QTableView::indicator:disabled, QListView::indicator:disabled, QAbstractItemView::indicator:disabled {
    border-color: #202028;
    background-color: #0a0a0f;
    image: none;
}

QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled, QGroupBox::indicator:checked:disabled,
QTreeView::indicator:checked:disabled, QTableView::indicator:checked:disabled, QListView::indicator:checked:disabled, QAbstractItemView::indicator:checked:disabled {
    background-color: #555566;
    border-color: #555566;
    image: none;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #FFFFFF;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    border: none;
    background-color: transparent;
    background: transparent;
}

/* Menus & MenuBar */
QMenuBar {
    background-color: #08080c;
    border-bottom: 1px solid #1c1c24;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    color: #ffffff;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #14141c;
    color: #00f2fe;
}

QMenuBar::item:pressed {
    background-color: #00f2fe;
    color: #FFFFFF;
}

QMenu {
    background-color: #08080c;
    border: 1px solid #1c1c24;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    color: #ffffff;
}

QMenu::item:selected {
    background-color: #00f2fe;
    color: #FFFFFF;
    font-weight: bold;
}

QMenu::separator {
    height: 1px;
    background-color: #1c1c24;
    margin: 4px 8px;
}

/* ToolBars */
QToolBar {
    background-color: #08080c;
    border-bottom: 1px solid #1c1c24;
    padding: 4px;
    spacing: 6px;
}

/* 3D Faceted Convex Buttons (Law 3 & STORM Standard) */
QPushButton, QDialogButtonBox QPushButton, QToolButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e2029, stop:0.48 #13141a, stop:0.52 #0e0f14, stop:1 #08080b);
    color: #FFFFFF;
    border-top: 1px solid rgba(255, 255, 255, 0.34);
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    border-right: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 3px solid rgba(0, 0, 0, 0.58);
    border-radius: 8px;
    padding: 6px 16px;
    font-weight: 600;
    min-height: 22px;
}

QPushButton:hover, QDialogButtonBox QPushButton:hover, QToolButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2c2f3d, stop:0.48 #1b1c24, stop:0.52 #15161d, stop:1 #0d0d12);
    border-top: 1px solid rgba(255, 255, 255, 0.55);
    border-left: 1px solid rgba(0, 242, 254, 0.45);
    border-right: 1px solid rgba(0, 242, 254, 0.45);
    border-bottom: 3px solid rgba(0, 0, 0, 0.70);
    color: #00f2fe;
}

QPushButton:pressed, QDialogButtonBox QPushButton:pressed, QToolButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #040406, stop:0.5 #0a0b0e, stop:1 #12131a);
    border-top: 2px solid rgba(0, 0, 0, 0.55);
    border-left: 1px solid rgba(0, 0, 0, 0.35);
    border-right: 1px solid rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: 8px;
    padding-bottom: 4px;
    color: #FFFFFF;
}

QPushButton:disabled, QDialogButtonBox QPushButton:disabled, QToolButton:disabled {
    background-color: #08080c;
    color: rgba(255, 255, 255, 0.35);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 1px solid rgba(255, 255, 255, 0.04);
    border-right: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 2px solid rgba(0, 0, 0, 0.40);
}

QPushButton:default, QDialogButtonBox QPushButton:default {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #38f9d7, stop:0.48 #00f2fe, stop:0.52 #00c6ff, stop:1 #0072ff);
    color: #050a12;
    border-top: 1px solid rgba(255, 255, 255, 0.55);
    border-left: 1px solid rgba(255, 255, 255, 0.28);
    border-right: 1px solid rgba(255, 255, 255, 0.28);
    border-bottom: 3px solid #004499;
    border-radius: 8px;
    font-weight: 700;
}

QPushButton:default:hover, QDialogButtonBox QPushButton:default:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #67fae0, stop:0.48 #38f9d7, stop:0.52 #00f2fe, stop:1 #00c6ff);
    border-top: 1px solid rgba(255, 255, 255, 0.75);
    border-bottom: 3px solid #002b66;
}

QPushButton:default:pressed, QDialogButtonBox QPushButton:default:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #004499, stop:0.5 #0072ff, stop:1 #00c6ff);
    border-top: 2px solid rgba(0, 0, 0, 0.50);
    border-bottom: 1px solid rgba(255, 255, 255, 0.20);
    padding-top: 8px;
    padding-bottom: 4px;
}

QPushButton:disabled {
    background-color: #08080c;
    color: #FFFFFF;
    border-color: #14141c;
}

/* Line Edits & Text Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0a0a10;
    color: #ffffff;
    border: 1px solid #222230;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #00f2fe;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00f2fe;
    background-color: #0e0e16;
}

/* Combo Box */
QComboBox {
    background-color: #0a0a10;
    color: #ffffff;
    border: 1px solid #222230;
    border-radius: 6px;
    padding: 2px 10px;
    min-height: 24px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #00f2fe;
}

QComboBox:on {
    border-color: #00f2fe;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #222230;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #08080c;
    border: 1px solid #222230;
    border-radius: 6px;
    selection-background-color: #00f2fe;
    selection-color: #FFFFFF;
    padding: 4px;
}

/* Tab Widget & Tab Bar */
QTabWidget::pane {
    border: 1px solid #1c1c24;
    background-color: #FFFFFF;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0a0a10;
    color: #FFFFFF;
    border: 1px solid #1c1c24;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #00f2fe;
    border-color: #00f2fe;
    border-bottom: 2px solid #000000;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #14141c;
    color: #ffffff;
    font-weight: bold;
}

QListWidget#selectorList {
    font-weight: bold;
    font-size: 9.5pt;
}

QListWidget#selectorList::item {
    font-weight: bold;
    padding: 8px 12px;
}

/* Tree & List Views (Game List) */
QTreeView, QListView, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #06060a;
    color: #FFFFFF;
    border: 1px solid #14141c;
    border-radius: 6px;
    gridline-color: #14141c;
    selection-background-color: rgba(0, 242, 254, 0.25);
    selection-color: #ffffff;
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 6px 10px;
    border-right: 1px solid #14141c;
    border-bottom: 1px solid #14141c;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: rgba(0, 242, 254, 0.15);
    color: #00f2fe;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: rgba(0, 242, 254, 0.32);
    color: #ffffff;
    font-weight: bold;
}

QHeaderView::section {
    background-color: #08080c;
    color: #00f2fe;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid #1c1c24;
    border-bottom: 1px solid #1c1c24;
    font-weight: 900;
    font-size: 8.5pt;
    text-align: center;
}

/* Status Bar & Footer */
QStatusBar {
    background-color: #050508;
    border-top: 1px solid #14141c;
    color: #FFFFFF;
    padding: 2px 4px;
}

QStatusBar::item {
    border: none;
}

/* Status Bar Group Container */
QWidget#StatusBarGroup {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 5px;
    margin: 1px;
}

QWidget#StatusBarGroup:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(0, 242, 254, 0.35);
}

QLabel#StatusBarGroupLabel {
    background: transparent;
    font-weight: 900;
    font-size: 7.2pt;
    letter-spacing: 1.2px;
}

/* Status Bar Buttons */
QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton,
QPushButton#RefreshButton,
QPushButton#VolumeButton,
QStatusBar QPushButton {
    background-color: #0c0d14;
    color: #ffffff;
    border: 1px solid #1c1c24;
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 800;
    min-height: 30px;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover,
QPushButton#RefreshButton:hover,
QPushButton#VolumeButton:hover,
QStatusBar QPushButton:hover {
    background-color: #141622;
    border-color: #00f2fe;
    color: #00f2fe;
}

QPushButton#TogglableStatusBarButton:checked,
QPushButton#RendererStatusBarButton:checked,
QPushButton#GPUStatusBarButton:checked,
QPushButton#DockingStatusBarButton:checked {
    background-color: rgba(0, 242, 254, 0.18);
    border-color: #00f2fe;
    color: #00f2fe;
}

QPushButton#RefreshButton {
    background-color: rgba(0, 230, 118, 0.15);
    color: #00e676;
    border-color: #00e676;
}

QPushButton#RefreshButton:hover {
    background-color: #00e676;
    color: #FFFFFF;
}

/* Status Bar Labels Hover */
QStatusBar QLabel:hover,
QLabel#FirmwareLabel:hover,
QLabel#TASlabel:hover,
ClickableLabel:hover {
    color: #00f2fe;
    background-color: rgba(0, 242, 254, 0.12);
    border-radius: 3px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 7px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2a244d;
    min-height: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00f2fe;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 7px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2a244d;
    min-width: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00f2fe;
}

/* Progress Bar */
QProgressBar {
    background-color: #08080c;
    border: 1px solid #1c1c24;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #00f2fe;
    border-radius: 3px;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #1c1c24;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #00f2fe;
    font-weight: bold;
    background-color: transparent;
}

QGroupBox QWidget,
QGroupBox QLabel,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    background: transparent;
    background-color: transparent;
}

QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background: transparent;
    background-color: transparent;
}

/* ToolTip */
QToolTip {
    background-color: #08080c;
    color: #ffffff;
    border: 1px solid #00f2fe;
    border-radius: 6px;
    padding: 6px;
}

/* Menus & MenuBar */
QMenuBar {
    background-color: #050508;
    color: #ffffff;
    font-weight: 800;
    font-size: 9.5pt;
    padding: 3px 6px;
    border-bottom: 1px solid #14141c;
}

QMenuBar::item {
    background-color: transparent;
    color: #ffffff;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 4px;
    margin-right: 4px;
}

QMenuBar::item:selected, QMenuBar::item:hover {
    background-color: rgba(0, 242, 254, 0.18);
    color: #00f2fe;
}

QMenuBar::item:pressed {
    background-color: #00f2fe;
    color: #FFFFFF;
}

QMenu {
    background-color: #08080e;
    color: #ffffff;
    border: 1px solid #1e283d;
    border-radius: 8px;
    padding: 4px;
    min-width: 130px;
}

QMenu::item {
    padding: 6px 20px 6px 20px;
    border-radius: 5px;
    margin: 2px 4px;
    font-weight: 600;
    font-size: 9pt;
}

QMenu::item:selected {
    background-color: #00f2fe;
    color: #FFFFFF;
    font-weight: 700;
}

QMenu::item:disabled {
    color: #FFFFFF;
    background-color: transparent;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background-color: #1a1a26;
    margin: 4px 8px;
}

/* QSlider Styling - STORM NIGHT */
QSlider {
    min-height: 24px;
    background: transparent;
}

QSlider::groove:horizontal {
    border: 1px solid #1c1c24;
    height: 6px;
    background: #0d0d12;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00f2fe, stop:1 #4facfe);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #14141d;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #ffffff, stop:1.0 #00f2fe);
    border: 2px solid #00f2fe;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 2px solid #38f8ff;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:pressed {
    background: #00f2fe;
    border: 2px solid #ffffff;
}

QSlider::handle:horizontal:disabled {
    background: #333340;
    border: 2px solid #202028;
}

QSlider::groove:vertical {
    border: 1px solid #1c1c24;
    width: 6px;
    background: #0d0d12;
    margin: 0 2px;
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background: #14141d;
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4facfe, stop:1 #00f2fe);
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #ffffff, stop:1.0 #00f2fe);
    border: 2px solid #00f2fe;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background: #ffffff;
    border: 2px solid #38f8ff;
    width: 18px;
    height: 18px;
    margin: 0 -7px;
    border-radius: 9px;
}

QSlider::handle:vertical:pressed {
    background: #00f2fe;
    border: 2px solid #ffffff;
}


/* STORM STRUCTURED UI RULES - STORM_NIGHT */

/* Structured Recessed Search Capsule (Law 17 & 23) */
QLineEdit#SettingsSearchEdit,
QLineEdit[stormSearchBox="true"] {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 8px;
    padding: 6px 14px;
    color: #ffffff;
    font-size: 12.5px;
    min-height: 32px;
}
QLineEdit#SettingsSearchEdit:focus,
QLineEdit[stormSearchBox="true"]:focus {
    border: 1px solid #00f0ff;
    background-color: rgba(255, 255, 255, 0.09);
}

/* Volumetric Sculpted Section Cards (QGroupBox) */
QGroupBox[stormCard="true"],
QGroupBox#groupBox[stormHeroCard="true"],
QGroupBox#BentoGameHeaderCard {
    background-color: rgba(15, 15, 15, 0.90);
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 10px;
    margin-top: 14px;
    padding: 24px 14px 14px 14px;
}
QGroupBox[stormCard="true"]::title,
QGroupBox#groupBox[stormHeroCard="true"]::title,
QGroupBox#BentoGameHeaderCard::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 2px 10px;
    color: #00f0ff;
    font-size: 12px;
    font-weight: bold;
    background-color: #050505;
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 4px;
}

/* Recessed 3D Inputs, SpinBoxes & Dropdowns (Law 17/23) */
QLineEdit[stormCapsule="true"],
QSpinBox[stormCapsule="true"],
QDoubleSpinBox[stormCapsule="true"],
QComboBox[stormCapsule="true"] {
    min-height: 32px;
    border-radius: 6px;
    padding: 4px 10px;
}

/* Per-Game Override Row Accent Highlight */
QWidget[stormOverrideRow="true"],
ConfigurationShared--Widget[stormOverrideRow="true"] {
    border-left: 3px solid #00f0ff;
    background-color: rgba(0, 240, 255, 0.07);
    border-radius: 4px;
}

/* 3D Faceted Reset Custom Settings Button */
QPushButton#ResetPerGameHeroButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ef4444, stop:0.48 #dc2626, stop:0.52 #b91c1c, stop:1 #991b1b);
    color: #FFFFFF;
    border-top: 1px solid rgba(255, 255, 255, 0.45);
    border-left: 1px solid rgba(255, 255, 255, 0.20);
    border-right: 1px solid rgba(255, 255, 255, 0.20);
    border-bottom: 3px solid #7f1d1d;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: bold;
    font-size: 11.5px;
    min-height: 30px;
}
QPushButton#ResetPerGameHeroButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f87171, stop:0.48 #ef4444, stop:0.52 #dc2626, stop:1 #b91c1c);
    border-top: 1px solid rgba(255, 255, 255, 0.65);
    border-bottom: 3px solid #7f1d1d;
}
QPushButton#ResetPerGameHeroButton:pressed {
    background: #991b1b;
    border-top: 2px solid rgba(0, 0, 0, 0.60);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: 8px;
    padding-bottom: 4px;
}

/* Recessed 3D Status Bar Telemetry Capsules (Law 20) */
QWidget[stormStatusCapsule="true"],
QWidget#StatusBarGroup {
    border-radius: 6px;
    margin: 1px 2px;
    padding: 1px 3px;
}
QWidget[stormStatusCapsule="true"]:hover,
QWidget#StatusBarGroup:hover {
    border-color: #00f0ff;
}

/* Visible 1px Vertical Column Dividers in All Tables (Law 12) */
QTableView[stormTable="true"]::item,
QTreeView[stormTable="true"]::item,
QTableWidget[stormTable="true"]::item,
QTreeWidget[stormTable="true"]::item {
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 10px;
}
QHeaderView::section {
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}
