/*
 * STORM GOTHIC Stylesheet - Dark Crimson, Ruby & Blood Black Gothic Theme
 * Exclusively for STORM SWITCH 3
 */

QWidget {
    color: #FFFFFF;
    background-color: #080404;
    font-family: "Segoe UI", "Outfit", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 9pt;
    outline: none;
    border: none;
}

QWidget:disabled {
    color: #FFFFFF;
    background-color: #040202;
}

QLabel {
    background: transparent;
    background-color: transparent;
    color: #FFFFFF;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: #FFFFFF;
    spacing: 8px;
    padding: 3px;
    font-weight: 500;
}

/* Law 12 & Law 19: Red OFF / Green ON Checkboxes */
QCheckBox::indicator, QGroupBox::indicator, QRadioButton::indicator,
QTreeView::indicator, QTableView::indicator, QListView::indicator, QAbstractItemView::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid #EF4444;
    background-color: rgba(239, 68, 68, 0.18);
    image: none;
}
QCheckBox::indicator:hover, QGroupBox::indicator:hover, QRadioButton::indicator:hover,
QTreeView::indicator:hover, QTableView::indicator:hover, QListView::indicator:hover, QAbstractItemView::indicator:hover {
    border-color: #F87171;
    background-color: rgba(239, 68, 68, 0.28);
    image: none;
}
QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked, QRadioButton::indicator:unchecked,
QTreeView::indicator:unchecked, QTableView::indicator:unchecked, QListView::indicator:unchecked, QAbstractItemView::indicator:unchecked {
    border: 1px solid #EF4444;
    background-color: rgba(239, 68, 68, 0.18);
    border-radius: 4px;
    image: none;
}
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover,
QTreeView::indicator:unchecked:hover, QTableView::indicator:unchecked:hover, QListView::indicator:unchecked:hover, QAbstractItemView::indicator:unchecked:hover {
    border-color: #F87171;
    background-color: rgba(239, 68, 68, 0.28);
    image: none;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QRadioButton::indicator:checked,
QTreeView::indicator:checked, QTableView::indicator:checked, QListView::indicator:checked, QAbstractItemView::indicator:checked {
    background-color: #10B981;
    border: 1px solid #10B981;
    border-radius: 4px;
    image: none;
}
QCheckBox::indicator:checked:hover, QGroupBox::indicator:checked:hover, QRadioButton::indicator:checked:hover,
QTreeView::indicator:checked:hover, QTableView::indicator:checked:hover, QListView::indicator:checked:hover, QAbstractItemView::indicator:checked:hover {
    background-color: #34D399;
    border-color: #34D399;
    image: none;
}
QCheckBox::indicator:disabled, QGroupBox::indicator:disabled, QRadioButton::indicator:disabled,
QTreeView::indicator:disabled, QTableView::indicator:disabled, QListView::indicator:disabled, QAbstractItemView::indicator:disabled {
    border-color: #4B5563;
    background-color: rgba(75, 85, 99, 0.2);
    image: none;
}
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled,
QTreeView::indicator:checked:disabled, QTableView::indicator:checked:disabled, QListView::indicator:checked:disabled, QAbstractItemView::indicator:checked:disabled {
    background-color: #065F46;
    border-color: #065F46;
    image: none;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #080404;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    border: none;
    background-color: transparent;
    background: transparent;
}

/* Menus & MenuBar */
QMenuBar {
    background-color: #0e0606;
    border-bottom: 1px solid #240c0c;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    color: #FFFFFF;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1e0b0b;
    color: #ff1744;
}

QMenuBar::item:pressed {
    background-color: #ff1744;
    color: #ffffff;
}

QMenu {
    background-color: #0e0606;
    border: 1px solid #ff1744;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #ff1744;
    color: #ffffff;
    font-weight: bold;
}

QMenu::separator {
    height: 1px;
    background-color: #240c0c;
    margin: 4px 8px;
}

/* ToolBars */
QToolBar {
    background-color: #0e0606;
    border-bottom: 1px solid #240c0c;
    padding: 4px;
    spacing: 6px;
}

/* Clean 1px Faceted Buttons (STORM Standard) */
QPushButton, QDialogButtonBox QPushButton, QToolButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #251a33, stop:1 #0f0a17);
    color: #FFFFFF;
    border: 1px solid #38274d;
    border-radius: 7px;
    padding: 6px 16px;
    font-weight: 600;
    min-height: 22px;
}

QPushButton:hover, QDialogButtonBox QPushButton:hover, QToolButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #36264a, stop:1 #171024);
    border: 1px solid #a855f7;
    color: #c084fc;
}

QPushButton:pressed, QDialogButtonBox QPushButton:pressed, QToolButton:pressed {
    background-color: #0a0710;
    border: 1px solid #9333ea;
    padding: 6px 16px;
    color: #FFFFFF;
}

QPushButton:disabled, QDialogButtonBox QPushButton:disabled, QToolButton:disabled {
    background-color: #09060e;
    color: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 7px;
    padding: 6px 16px;
}

QPushButton:default, QDialogButtonBox QPushButton:default {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #a855f7, stop:1 #7e22ce);
    color: #FFFFFF;
    border: 1px solid #9333ea;
    border-radius: 7px;
    padding: 6px 16px;
    font-weight: 700;
    min-height: 22px;
}

QPushButton:default:hover, QDialogButtonBox QPushButton:default:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c084fc, stop:1 #9333ea);
    border: 1px solid #c084fc;
}

QPushButton:default:pressed, QDialogButtonBox QPushButton:default:pressed {
    background-color: #581c87;
    border: 1px solid #4a148c;
    padding: 6px 16px;
}

QPushButton:disabled {
    background-color: #0b0712;
    color: rgba(255, 255, 255, 0.35);
    border: 1px solid #1c1226;
}

/* Line Edits & Text Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #290f0f;
    border-radius: 6px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 10px;
    padding-right: 28px;
    selection-background-color: #ff1744;
    selection-color: #ffffff;
    min-height: 32px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #ff1744;
    background-color: #150909;
}

/* Combo Box */
QComboBox {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #290f0f;
    border-radius: 6px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 10px;
    padding-right: 28px;
    min-height: 32px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #ff1744;
}

QComboBox:on {
    border-color: #ff1744;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #290f0f;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #0e0606;
    border: 1px solid #ff1744;
    border-radius: 6px;
    selection-background-color: #ff1744;
    selection-color: #ffffff;
    padding: 4px;
}

/* Tab Widget & Tab Bar */
QTabWidget::pane {
    border: 1px solid #240c0c;
    background-color: #080404;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #240c0c;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #080404;
    color: #ff1744;
    border-color: #ff1744;
    border-bottom: 2px solid #080404;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #180a0a;
    color: #FFFFFF;
    font-weight: bold;
}

QListWidget#selectorList {
    font-weight: bold;
    font-size: 9.5pt;
}

QListWidget#selectorList::item {
    font-weight: bold;
    padding: 8px 12px;
}

/* Tree & List Views (Game List) */
QTreeView, QListView, QTableView {
    background-color: #080404;
    alternate-background-color: #0f0707;
    color: #FFFFFF;
    border: 1px solid #1c0a0a;
    border-radius: 6px;
    gridline-color: #1c0a0a;
    selection-background-color: rgba(255, 23, 68, 0.22);
    selection-color: #ffffff;
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 6px 10px;
    border-right: 1px solid #1c0a0a;
    border-bottom: 1px solid #1c0a0a;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: rgba(255, 23, 68, 0.15);
    color: #ff1744;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: rgba(255, 23, 68, 0.32);
    color: #ffffff;
    font-weight: bold;
}

QHeaderView::section {
    background-color: #0e0606;
    color: #ff1744;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid #240c0c;
    border-bottom: 1px solid #240c0c;
    font-weight: 900;
    font-size: 8.5pt;
    text-align: center;
}

/* Status Bar & Footer */
QStatusBar {
    background-color: #050202;
    border-top: 1px solid #1c0a0a;
    color: #FFFFFF;
    padding: 2px 4px;
}

QStatusBar::item {
    border: none;
}

/* Status Bar Group Container */
QWidget#StatusBarGroup {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 5px;
    margin: 1px;
}

QWidget#StatusBarGroup:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 23, 68, 0.40);
}

QLabel#StatusBarGroupLabel {
    background: transparent;
    font-weight: 900;
    font-size: 7.2pt;
    letter-spacing: 1.2px;
}

/* Status Bar Buttons */
QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton,
QPushButton#RefreshButton,
QPushButton#VolumeButton,
QStatusBar QPushButton {
    background-color: #100606;
    color: #ffffff;
    border: 1px solid #260d0d;
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 800;
    min-height: 30px;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover,
QPushButton#RefreshButton:hover,
QPushButton#VolumeButton:hover,
QStatusBar QPushButton:hover {
    background-color: #1c0a0a;
    border-color: #ff1744;
    color: #ff1744;
}

QPushButton#TogglableStatusBarButton:checked,
QPushButton#RendererStatusBarButton:checked,
QPushButton#GPUStatusBarButton:checked,
QPushButton#DockingStatusBarButton:checked {
    background-color: rgba(255, 23, 68, 0.22);
    border-color: #ff1744;
    color: #ff1744;
}

QPushButton#RefreshButton {
    background-color: rgba(0, 230, 118, 0.15);
    color: #00e676;
    border-color: #00e676;
}

QPushButton#RefreshButton:hover {
    background-color: #00e676;
    color: #FFFFFF;
}

/* Status Bar Labels Hover */
QStatusBar QLabel:hover,
QLabel#FirmwareLabel:hover,
QLabel#TASlabel:hover,
ClickableLabel:hover {
    color: #ff1744;
    background-color: rgba(255, 23, 68, 0.15);
    border-radius: 3px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2a244d;
    min-height: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #ff1744;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 7px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2a244d;
    min-width: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #ff1744;
}

/* Progress Bar */
QProgressBar {
    background-color: #0e0606;
    border: 1px solid #240c0c;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #ff1744;
    border-radius: 3px;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #240c0c;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #ff1744;
    font-weight: bold;
    background-color: transparent;
}

QGroupBox QWidget,
QGroupBox QLabel,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    background: transparent;
    background-color: transparent;
}

QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background: transparent;
    background-color: transparent;
}

/* ToolTip */
QToolTip {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #ff1744;
    border-radius: 6px;
    padding: 6px;
}

/* QSlider Styling - STORM GOTHIC */
QSlider {
    min-height: 24px;
    background: transparent;
}

QSlider::groove:horizontal {
    border: 1px solid #240c0c;
    height: 6px;
    background: #0e0606;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d50000, stop:1 #ff1744);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #180909;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #ffffff, stop:1.0 #ff1744);
    border: 2px solid #ff1744;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 2px solid #ff5252;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:pressed {
    background: #ff1744;
    border: 2px solid #ffffff;
}

QSlider::handle:horizontal:disabled {
    background: #3e1e1e;
    border: 2px solid #240c0c;
}

QSlider::groove:vertical {
    border: 1px solid #240c0c;
    width: 6px;
    background: #0e0606;
    margin: 0 2px;
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background: #180909;
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff1744, stop:1 #d50000);
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #ffffff, stop:1.0 #ff1744);
    border: 2px solid #ff1744;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background: #ffffff;
    border: 2px solid #ff5252;
    width: 18px;
    height: 18px;
    margin: 0 -7px;
    border-radius: 9px;
}

QSlider::handle:vertical:pressed {
    background: #ff1744;
    border: 2px solid #ffffff;
}


/* STORM STRUCTURED UI RULES - STORM_GOTHIC */

/* Structured Recessed Search Capsule (Law 17 & 23) */
QLineEdit#SettingsSearchEdit,
QLineEdit[stormSearchBox="true"] {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(229, 57, 53, 0.35);
    border-radius: 8px;
    padding: 6px 14px;
    color: #ffffff;
    font-size: 12.5px;
    min-height: 32px;
}
QLineEdit#SettingsSearchEdit:focus,
QLineEdit[stormSearchBox="true"]:focus {
    border: 1px solid #e53935;
    background-color: rgba(255, 255, 255, 0.09);
}

/* Volumetric Sculpted Section Cards (QGroupBox) */
QGroupBox[stormCard="true"],
QGroupBox#groupBox[stormHeroCard="true"],
QGroupBox#BentoGameHeaderCard {
    background-color: rgba(22, 8, 8, 0.85);
    border: 1px solid rgba(229, 57, 53, 0.35);
    border-radius: 10px;
    margin-top: 14px;
    padding: 24px 14px 14px 14px;
}
QGroupBox[stormCard="true"]::title,
QGroupBox#groupBox[stormHeroCard="true"]::title,
QGroupBox#BentoGameHeaderCard::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 2px 10px;
    color: #e53935;
    font-size: 12px;
    font-weight: bold;
    background-color: #080404;
    border: 1px solid rgba(229, 57, 53, 0.35);
    border-radius: 4px;
}

/* Recessed 3D Inputs, SpinBoxes & Dropdowns (Law 17/23) */
QLineEdit[stormCapsule="true"],
QSpinBox[stormCapsule="true"],
QDoubleSpinBox[stormCapsule="true"],
QComboBox[stormCapsule="true"] {
    min-height: 32px;
    border-radius: 6px;
    padding: 4px 10px;
}

/* Per-Game Override Row Accent Highlight */
QWidget[stormOverrideRow="true"],
ConfigurationShared--Widget[stormOverrideRow="true"] {
    border-left: 3px solid #e53935;
    background-color: rgba(0, 240, 255, 0.07);
    border-radius: 4px;
}

/* Clean 1px Faceted Reset Custom Settings Button */
QPushButton#ResetPerGameHeroButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ef4444, stop:1 #b91c1c);
    color: #FFFFFF;
    border: 1px solid #dc2626;
    border-radius: 7px;
    padding: 6px 14px;
    font-weight: bold;
    font-size: 11.5px;
    min-height: 30px;
}
QPushButton#ResetPerGameHeroButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f87171, stop:1 #dc2626);
    border: 1px solid #fca5a5;
}
QPushButton#ResetPerGameHeroButton:pressed {
    background: #991b1b;
    border: 1px solid #7f1d1d;
    padding: 6px 14px;
}

/* Recessed 3D Status Bar Telemetry Capsules (Law 20) */
QWidget[stormStatusCapsule="true"],
QWidget#StatusBarGroup {
    border-radius: 6px;
    margin: 1px 2px;
    padding: 1px 3px;
}
QWidget[stormStatusCapsule="true"]:hover,
QWidget#StatusBarGroup:hover {
    border-color: #e53935;
}

/* Visible 1px Vertical Column Dividers in All Tables (Law 12) */
QTableView[stormTable="true"]::item,
QTreeView[stormTable="true"]::item,
QTableWidget[stormTable="true"]::item,
QTreeWidget[stormTable="true"]::item {
    border-right: 1px solid rgba(229, 57, 53, 0.18);
    border-bottom: 1px solid rgba(229, 57, 53, 0.18);
    padding: 6px 10px;
}
QHeaderView::section {
    border-right: 1px solid rgba(229, 57, 53, 0.18);
    border-bottom: 1px solid rgba(229, 57, 53, 0.18);
}

QSpinBox QLineEdit, QDoubleSpinBox QLineEdit {
    padding: 0px;
    margin: 0px;
    border: none;
    background: transparent;
}

/* --- STORM SWITCH Structured UI & Status Bar Rules --- */
QLineEdit#SettingsSearchEdit,
QLineEdit#HotkeysSearchEdit,
QLineEdit[stormSearchBox="true"] {
    background-color: #0F172A;
    border: 1px solid rgba(0, 210, 255, 0.35);
    border-radius: 7px;
    padding: 6px 12px;
    color: #FFFFFF;
    font-size: 12.5px;
    margin-bottom: 4px;
}
QLineEdit#SettingsSearchEdit:focus,
QLineEdit#HotkeysSearchEdit:focus,
QLineEdit[stormSearchBox="true"]:focus {
    border: 1px solid #00F0FF;
    background-color: #162032;
}

QListWidget#SettingsSearchResultsList {
    background-color: #0B1325;
    border: 1px solid #00F0FF;
    border-radius: 7px;
    padding: 4px;
    color: #FFFFFF;
    font-size: 12px;
    margin-bottom: 6px;
    outline: none;
}
QListWidget#SettingsSearchResultsList::item {
    padding: 6px 10px;
    border-radius: 5px;
    margin: 1px 0px;
}
QListWidget#SettingsSearchResultsList::item:hover {
    background-color: rgba(0, 240, 255, 0.16);
    color: #FFFFFF;
}
QListWidget#SettingsSearchResultsList::item:selected {
    background-color: rgba(0, 240, 255, 0.26);
    border-left: 3px solid #00F0FF;
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#ShaderBuildingLabel[compiling="true"] {
    background-color: rgba(255, 64, 129, 0.12);
    color: #ff4081;
    border: 1px solid rgba(255, 64, 129, 0.35);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QLabel#EmuSpeedLabel {
    background-color: rgba(0, 230, 118, 0.10);
    color: #00e676;
    border: 1px solid rgba(0, 230, 118, 0.30);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QLabel#GameFpsLabel {
    background-color: rgba(0, 229, 255, 0.10);
    color: #00e5ff;
    border: 1px solid rgba(0, 229, 255, 0.30);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QLabel#EmuFrametimeLabel {
    background-color: rgba(255, 202, 40, 0.10);
    color: #ffca28;
    border: 1px solid rgba(255, 202, 40, 0.30);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QListWidget#PerGameSelectorList,
QListWidget[stormList="true"] {
    background-color: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    outline: none;
    padding: 4px;
}
QListWidget#PerGameSelectorList::item,
QListWidget[stormList="true"]::item {
    padding: 8px 12px;
    border-radius: 5px;
    margin: 2px 0px;
    color: #E2E8F0;
    font-weight: 600;
}
QListWidget#PerGameSelectorList::item:hover,
QListWidget[stormList="true"]::item:hover {
    background-color: rgba(0, 240, 255, 0.15);
    color: #00F0FF;
}
QListWidget#PerGameSelectorList::item:selected,
QListWidget[stormList="true"]::item:selected {
    background-color: rgba(0, 240, 255, 0.25);
    border-left: 3px solid #00F0FF;
    color: #00F0FF;
}

QGroupBox#BentoGameHeaderCard,
QGroupBox[stormHeroCard="true"] {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 10px;
    padding: 10px;
}
