<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_profile"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2A3950"
    app:cardBackgroundColor="#131B2B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Row: Icon + Name & Desc + Active Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/storm_tile_3d_recessed"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/image_profile_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="#38BDF8" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_profile_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Profile Name"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/text_profile_active_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_storm_badge_capsule"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:text="@string/profile_active_badge"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/text_profile_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Profile Description"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:maxLines="2" />

            </LinearLayout>

        </LinearLayout>

        <!-- Profile Actions: Row 1 [Применить] + [Поделиться] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_apply"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:text="@string/profile_btn_apply"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                app:strokeWidth="1dp"
                app:strokeColor="#4D38BDF8"
                app:cornerRadius="8dp"
                app:backgroundTint="#2038BDF8"
                app:icon="@drawable/ic_check"
                app:iconTint="#38BDF8"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_share"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:text="@string/profile_btn_share"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                app:strokeWidth="1dp"
                app:strokeColor="#334766"
                app:cornerRadius="8dp"
                app:backgroundTint="#1A2436"
                app:icon="@drawable/ic_share"
                app:iconTint="#94A3B8"
                app:iconSize="14dp" />

        </LinearLayout>

        <!-- Custom Profile Actions: Row 2 [Переименовать] + [Удалить] -->
        <LinearLayout
            android:id="@+id/layout_custom_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_rename"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:text="@string/profile_btn_rename"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                app:strokeWidth="1dp"
                app:strokeColor="#334766"
                app:cornerRadius="8dp"
                app:backgroundTint="#1A2436"
                app:icon="@drawable/ic_edit"
                app:iconTint="#94A3B8"
                app:iconSize="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_profile_delete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:singleLine="true"
                android:ellipsize="none"
                android:text="@string/profile_btn_delete"
                android:textColor="#F87171"
                android:textSize="12sp"
                app:strokeWidth="1dp"
                app:strokeColor="#66EF4444"
                app:cornerRadius="8dp"
                app:backgroundTint="#22EF4444"
                app:icon="@drawable/ic_delete"
                app:iconTint="#F87171"
                app:iconSize="14dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
