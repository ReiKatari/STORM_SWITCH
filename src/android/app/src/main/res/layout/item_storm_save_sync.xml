<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_game_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/colorSurface"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_cartridge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_game_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Assassin's Creed: The Rebel Collection" />

                <TextView
                    android:id="@+id/text_title_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    tools:text="010044700DEB0000" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_sync_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_pill_emerald"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#10B981"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🟢 Синхронизировано" />
        </LinearLayout>

        <!-- Details Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/colorSurface"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/text_local_save_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                tools:text="📱 На этом устройстве: 14.09.2026 13:30 (1.4 МБ, 6 файлов)" />

            <TextView
                android:id="@+id/text_remote_save_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="💻 На удалённом устройстве: 14.09.2026 13:35 (1.5 МБ, 6 файлов)" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_sync"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Синхронизировать"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                app:backgroundTint="?attr/colorSurface"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
