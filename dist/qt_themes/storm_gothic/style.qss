/*
 * STORM GOTHIC Stylesheet - Dark Crimson, Ruby & Blood Black Gothic Theme
 * Exclusively for STORM SWITCH 3
 */

QWidget {
    color: #FFFFFF;
    background-color: #080404;
    font-family: "Segoe UI", "Outfit", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 9pt;
    outline: none;
    border: none;
}

QWidget:disabled {
    color: #FFFFFF;
    background-color: #040202;
}

QLabel {
    background: transparent;
    background-color: transparent;
    color: #FFFFFF;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: #FFFFFF;
    spacing: 8px;
    padding: 3px;
    font-weight: 500;
}

QCheckBox::indicator, QRadioButton::indicator,
QTreeView::indicator, QTableView::indicator, QListView::indicator, QAbstractItemView::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1.5px solid #3d1414;
    background-color: #080404;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover,
QTreeView::indicator:hover, QTableView::indicator:hover, QListView::indicator:hover, QAbstractItemView::indicator:hover {
    border-color: #ff1744;
    background-color: #1a0808;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked,
QTreeView::indicator:checked, QTableView::indicator:checked, QListView::indicator:checked, QAbstractItemView::indicator:checked {
    background-color: #ff1744;
    border: 1.5px solid #ff1744;
    image: none;
}

QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover,
QTreeView::indicator:checked:hover, QTableView::indicator:checked:hover, QListView::indicator:checked:hover, QAbstractItemView::indicator:checked:hover {
    background-color: #ff4569;
    border-color: #ff4569;
    image: none;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled,
QTreeView::indicator:disabled, QTableView::indicator:disabled, QListView::indicator:disabled, QAbstractItemView::indicator:disabled {
    border-color: #240c0c;
    background-color: #050202;
    image: none;
}

QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled,
QTreeView::indicator:checked:disabled, QTableView::indicator:checked:disabled, QListView::indicator:checked:disabled, QAbstractItemView::indicator:checked:disabled {
    background-color: #662020;
    border-color: #662020;
    image: none;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #080404;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    border: none;
    background-color: transparent;
    background: transparent;
}

/* Menus & MenuBar */
QMenuBar {
    background-color: #0e0606;
    border-bottom: 1px solid #240c0c;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    color: #FFFFFF;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1e0b0b;
    color: #ff1744;
}

QMenuBar::item:pressed {
    background-color: #ff1744;
    color: #ffffff;
}

QMenu {
    background-color: #0e0606;
    border: 1px solid #ff1744;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #ff1744;
    color: #ffffff;
    font-weight: bold;
}

QMenu::separator {
    height: 1px;
    background-color: #240c0c;
    margin: 4px 8px;
}

/* ToolBars */
QToolBar {
    background-color: #0e0606;
    border-bottom: 1px solid #240c0c;
    padding: 4px;
    spacing: 6px;
}

QToolButton {
    background-color: #140808;
    border: 1px solid #290f0f;
    border-radius: 6px;
    padding: 5px 10px;
    color: #FFFFFF;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #210c0c;
    border-color: #ff1744;
    color: #ff1744;
}

QToolButton:pressed {
    background-color: #ff1744;
    color: #ffffff;
}

/* Push Buttons */
QPushButton {
    background-color: #140808;
    color: #FFFFFF;
    border: 1px solid #290f0f;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #240e0e;
    border-color: #ff1744;
    color: #ff1744;
}

QPushButton:pressed {
    background-color: #ff1744;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #090303;
    color: #FFFFFF;
    border-color: #170707;
}

/* Line Edits & Text Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #290f0f;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #ff1744;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #ff1744;
    background-color: #150909;
}

/* Combo Box */
QComboBox {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #290f0f;
    border-radius: 6px;
    padding: 2px 10px;
    min-height: 24px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #ff1744;
}

QComboBox:on {
    border-color: #ff1744;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #290f0f;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #0e0606;
    border: 1px solid #ff1744;
    border-radius: 6px;
    selection-background-color: #ff1744;
    selection-color: #ffffff;
    padding: 4px;
}

/* Tab Widget & Tab Bar */
QTabWidget::pane {
    border: 1px solid #240c0c;
    background-color: #080404;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #240c0c;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #080404;
    color: #ff1744;
    border-color: #ff1744;
    border-bottom: 2px solid #080404;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #180a0a;
    color: #FFFFFF;
    font-weight: bold;
}

QListWidget#selectorList {
    font-weight: bold;
    font-size: 9.5pt;
}

QListWidget#selectorList::item {
    font-weight: bold;
    padding: 8px 12px;
}

/* Tree & List Views (Game List) */
QTreeView, QListView, QTableView {
    background-color: #080404;
    alternate-background-color: #0f0707;
    color: #FFFFFF;
    border: 1px solid #1c0a0a;
    border-radius: 6px;
    gridline-color: #1c0a0a;
    selection-background-color: rgba(255, 23, 68, 0.22);
    selection-color: #ffffff;
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 6px 10px;
    border-right: 1px solid #1c0a0a;
    border-bottom: 1px solid #1c0a0a;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: rgba(255, 23, 68, 0.15);
    color: #ff1744;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: rgba(255, 23, 68, 0.32);
    color: #ffffff;
    font-weight: bold;
}

QHeaderView::section {
    background-color: #0e0606;
    color: #ff1744;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid #240c0c;
    border-bottom: 1px solid #240c0c;
    font-weight: 900;
    font-size: 8.5pt;
    text-align: center;
}

/* Status Bar & Footer */
QStatusBar {
    background-color: #050202;
    border-top: 1px solid #1c0a0a;
    color: #FFFFFF;
    padding: 2px 4px;
}

QStatusBar::item {
    border: none;
}

/* Status Bar Group Container */
QWidget#StatusBarGroup {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 5px;
    margin: 1px;
}

QWidget#StatusBarGroup:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 23, 68, 0.40);
}

QLabel#StatusBarGroupLabel {
    background: transparent;
    font-weight: 900;
    font-size: 7.2pt;
    letter-spacing: 1.2px;
}

/* Status Bar Buttons */
QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton,
QPushButton#RefreshButton,
QPushButton#VolumeButton,
QStatusBar QPushButton {
    background-color: #100606;
    color: #ffffff;
    border: 1px solid #260d0d;
    border-radius: 5px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 800;
    min-height: 30px;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover,
QPushButton#RefreshButton:hover,
QPushButton#VolumeButton:hover,
QStatusBar QPushButton:hover {
    background-color: #1c0a0a;
    border-color: #ff1744;
    color: #ff1744;
}

QPushButton#TogglableStatusBarButton:checked,
QPushButton#RendererStatusBarButton:checked,
QPushButton#GPUStatusBarButton:checked,
QPushButton#DockingStatusBarButton:checked {
    background-color: rgba(255, 23, 68, 0.22);
    border-color: #ff1744;
    color: #ff1744;
}

QPushButton#RefreshButton {
    background-color: rgba(0, 230, 118, 0.15);
    color: #00e676;
    border-color: #00e676;
}

QPushButton#RefreshButton:hover {
    background-color: #00e676;
    color: #000000;
}

/* Status Bar Labels Hover */
QStatusBar QLabel:hover,
QLabel#FirmwareLabel:hover,
QLabel#TASlabel:hover,
ClickableLabel:hover {
    color: #ff1744;
    background-color: rgba(255, 23, 68, 0.15);
    border-radius: 3px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: #080404;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #240c0c;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #ff1744;
}

QScrollBar:horizontal {
    border: none;
    background-color: #080404;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #240c0c;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #ff1744;
}

/* Progress Bar */
QProgressBar {
    background-color: #0e0606;
    border: 1px solid #240c0c;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #ff1744;
    border-radius: 3px;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #240c0c;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    color: #ff1744;
    font-weight: bold;
    background-color: #080404;
}

/* ToolTip */
QToolTip {
    background-color: #0e0606;
    color: #FFFFFF;
    border: 1px solid #ff1744;
    border-radius: 6px;
    padding: 6px;
}

/* QSlider Styling - STORM GOTHIC */
QSlider {
    min-height: 24px;
    background: transparent;
}

QSlider::groove:horizontal {
    border: 1px solid #240c0c;
    height: 6px;
    background: #0e0606;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #d50000, stop:1 #ff1744);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #180909;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #ffffff, stop:1.0 #ff1744);
    border: 2px solid #ff1744;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
    border: 2px solid #ff5252;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:pressed {
    background: #ff1744;
    border: 2px solid #ffffff;
}

QSlider::handle:horizontal:disabled {
    background: #3e1e1e;
    border: 2px solid #240c0c;
}

QSlider::groove:vertical {
    border: 1px solid #240c0c;
    width: 6px;
    background: #0e0606;
    margin: 0 2px;
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background: #180909;
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ff1744, stop:1 #d50000);
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #ffffff, stop:1.0 #ff1744);
    border: 2px solid #ff1744;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background: #ffffff;
    border: 2px solid #ff5252;
    width: 18px;
    height: 18px;
    margin: 0 -7px;
    border-radius: 9px;
}

QSlider::handle:vertical:pressed {
    background: #ff1744;
    border: 2px solid #ffffff;
}

