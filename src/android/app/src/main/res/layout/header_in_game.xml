<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/EdenCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/text_game_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineHeight="17sp"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="Game Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/cpu_backend"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="Dynarmic" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginHorizontal="6dp"
                    android:textSize="11sp"
                    android:text="•" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/gpu_vendor"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="Adreno 740" />

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quick_settings_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#00F0FF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/quick_settings_gesture_hint" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>