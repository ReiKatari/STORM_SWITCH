<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Dialog Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/SynthwaveText.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/system_information"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_app_build"
                    style="@style/SynthwaveText.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STORM SWITCH 4.2.9"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Device & OS Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/EdenCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SynthwaveText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sysinfo_sec_device"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_device_info"
                            style="@style/SynthwaveText.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:textIsSelectable="true"
                            tools:text="Модель: Xiaomi 13 Pro\nОС: Android 14 (API 34)" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- CPU & SoC Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/EdenCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SynthwaveText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sysinfo_sec_cpu"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_cpu_info"
                            style="@style/SynthwaveText.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:textIsSelectable="true"
                            tools:text="SoC: Snapdragon 8 Gen 2\nЯдра: 8 cores" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- GPU & Graphics Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/EdenCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SynthwaveText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sysinfo_sec_gpu"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_gpu_info"
                            style="@style/SynthwaveText.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:textIsSelectable="true"
                            tools:text="GPU: Adreno 740\nVulkan: 1.3.268" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- RAM Memory Card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/EdenCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/SynthwaveText.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sysinfo_sec_ram"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="6dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/text_ram_info"
                            style="@style/SynthwaveText.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:textIsSelectable="true"
                            tools:text="Всего RAM: 12288 MB\nДоступно: 6420 MB" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy_info"

                style="@style/EdenButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/copy_to_clipboard"
                app:icon="@drawable/ic_export"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_close_dialog"

                style="@style/EdenButton.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/close"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
