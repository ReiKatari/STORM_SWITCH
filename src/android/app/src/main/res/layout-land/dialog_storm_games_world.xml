<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111827"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_website"
            app:tint="#00F0FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storm_games_world"
                android:textColor="#00F0FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_catalog_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Каталог игр Nintendo Switch"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Обновить"
            android:src="@drawable/ic_refresh"
            app:tint="#38BDF8" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Закрыть"
            android:src="@drawable/ic_clear"
            app:tint="#F1F5F9" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20354E" />

    <!-- Two-Pane Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Pane: Search + Games List -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="#161B26"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxStrokeColor="#00D2FF"
                    app:hintTextColor="#00D2FF"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="#38BDF8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Поиск игры по названию или ID..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingVertical="8dp"
                        android:textColor="#F1F5F9"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Language Filter Chips Bar -->
            <HorizontalScrollView
                android:id="@+id/scroll_language_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:paddingBottom="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_language_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_lang_all"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="🌐 Все языки"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:cornerRadius="16dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_lang_rus"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="🇷🇺 Русский"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:cornerRadius="16dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_lang_eng"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="🇬🇧 English"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:cornerRadius="16dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_lang_multi"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="🌍 Multi"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:cornerRadius="16dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_with_dlc"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="✨ DLC и моды"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:cornerRadius="16dp"
                        app:strokeColor="?attr/colorOutline"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_games"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />

                <ProgressBar
                    android:id="@+id/progress_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="#00F0FF"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/text_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Игры не найдены"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Bottom Pagination Bar -->
            <LinearLayout
                android:id="@+id/layout_pagination_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#101623"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="6dp"
                    android:background="#20354E" />

                <!-- Row 1: Sort Button (Left) and Pagination Info (Right) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sort_catalog"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="0dp"
                        android:text="А-Я"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        app:backgroundTint="#16263D"
                        app:strokeColor="#20354E"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_filter"
                        app:iconSize="14dp"
                        app:iconTint="#38BDF8" />

                    <TextView
                        android:id="@+id/text_pagination_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="end|center_vertical"
                        android:textAlignment="viewEnd"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Страница 1 из 45 (1120 игр)" />
                </LinearLayout>

                <!-- Row 2: Page Navigation (Centered Prev, Page Numbers, Next) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_page_prev"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="‹"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#00F0FF"
                        app:backgroundTint="#16263D"
                        app:strokeColor="#00D2FF"
                        app:strokeWidth="1dp" />

                    <HorizontalScrollView
                        android:id="@+id/scroll_page_numbers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_page_buttons"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_page_next"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="›"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#00F0FF"
                        app:backgroundTint="#16263D"
                        app:strokeColor="#00D2FF"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right Pane: Selected Game Details / Download Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_details_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_margin="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="#121A28"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:strokeColor="#00D2FF"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/detail_game_cover"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/default_icon"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/detail_game_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="#F1F5F9"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Diablo III: Eternal Collection" />

                            <!-- Badges Row 1: Version, Internal Version, Size -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/detail_game_version"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/badge_pill_cyan"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:textColor="#00D2FF"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    tools:text="1.0.10" />

                                <TextView
                                    android:id="@+id/detail_internal_version"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:background="@drawable/badge_pill_purple"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:textColor="#C084FC"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    tools:text="655360" />

                                <TextView
                                    android:id="@+id/detail_game_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:background="@drawable/badge_pill_amber"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:textColor="#FBBF24"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    tools:text="37,63 MB" />
                            </LinearLayout>

                            <!-- Badges Row 2: Languages, DLC, MOD -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/detail_game_langs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/badge_pill_blue"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:textColor="#38BDF8"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    tools:text="RUS" />

                                <TextView
                                    android:id="@+id/detail_game_dlc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:background="@drawable/badge_pill_emerald"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:textColor="#10B981"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:visibility="gone"
                                    tools:visibility="visible"
                                    tools:text="+5 DLC" />

                                <TextView
                                    android:id="@+id/detail_game_mod"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:background="@drawable/badge_pill_purple"
                                    android:paddingHorizontal="5dp"
                                    android:paddingVertical="1dp"
                                    android:textColor="#C084FC"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:visibility="gone"
                                    tools:visibility="visible"
                                    tools:text="+1 MOD" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/detail_game_meta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:visibility="gone"
                                android:textColor="#38BDF8"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/detail_game_id"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textColor="#38BDF8"
                                android:textSize="10sp"
                                tools:text="ID: 01001B700A654000" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detail_game_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="4"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        tools:text="Описание игры..." />

                    <TextView
                        android:id="@+id/detail_save_folder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="start"
                        android:maxLines="1"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        tools:text="📁 Папка: /storage/emulated/0/Switch" />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:id="@+id/layout_download_actions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_start_download"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="Скачать игру"
                            android:textColor="#0A0E17"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#00D2FF"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_install"
                            app:iconTint="#0A0E17" />
                    </LinearLayout>

                    <!-- Download progress -->
                    <LinearLayout
                        android:id="@+id/layout_download_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_download"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            app:indicatorColor="#00F0FF"
                            app:trackColor="#20354E"
                            app:trackCornerRadius="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/text_download_stats"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="#E0E8F0"
                                android:textSize="10sp"
                                tools:text="150 МБ из 4.2 ГБ • 14.5 МБ/с • Ост: 4 мин" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_pause_download"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginEnd="4dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp"
                                android:text="Пауза"
                                android:textColor="#38BDF8"
                                android:textSize="10sp"
                                app:cornerRadius="6dp"
                                app:strokeColor="#00D2FF" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_cancel_download"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp"
                                android:text="Отмена"
                                android:textColor="#FF6666"
                                android:textSize="10sp"
                                app:cornerRadius="6dp"
                                app:strokeColor="#FF4444" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
