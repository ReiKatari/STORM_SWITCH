           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-size:10.5pt; color:#e0e6ed;&quot;&gt;STORM SWITCH is an advanced high-performance multi-platform Nintendo Switch and Nintendo Switch 2 emulator built atop Eden for maximum speed, Vulkan pipeline stability, on-the-fly compressed container streaming (NSZ/NCZ/XCZ and .nup), STORM SAVE SYNC cloud synchronization, and deep customization.&lt;br /&gt;&lt;br /&gt;STORM SWITCH is distributed under the open-source GPLv3.0+ license and integrates an expanded GameFix Database, GameBanana mods, Cheats Manager, and Amiibo Manager.&lt;br /&gt;&lt;br /&gt;This software is intended exclusively for running legally obtained copies of games.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
