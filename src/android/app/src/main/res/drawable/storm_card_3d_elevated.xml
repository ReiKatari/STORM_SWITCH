<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom 3D Bevel depth -->
    <item android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#0B0917" />
        </shape>
    </item>
    <!-- Main elevated body -->
    <item android:top="0dp" android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:startColor="#221C3D"
                android:centerColor="#1B1632"
                android:endColor="#141026"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#408B5CF6" />
        </shape>
    </item>
    <!-- Top specular highlight -->
    <item android:top="1dp" android:bottom="4dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp"
                android:bottomLeftRadius="6dp"
                android:bottomRightRadius="6dp" />
            <gradient
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
