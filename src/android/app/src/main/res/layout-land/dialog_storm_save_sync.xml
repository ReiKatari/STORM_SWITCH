<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="?attr/colorSurfaceVariant">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_sync"
            app:tint="?attr/colorPrimary"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STORM SAVE SYNC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storm_sync_subtitle"
                android:textSize="10.5sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/storm_sync_refresh" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_clear"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="@string/storm_sync_close" />

    </LinearLayout>

    <!-- Main Content: 2 Columns for Landscape -->
    <LinearLayout
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="10dp">

        <!-- Left Column: Connection & Discovered Devices -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. My Device Key Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storm_sync_device_key_label"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/text_my_key"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="STORM-..."
                                android:textSize="11.5sp"
                                android:fontFamily="monospace"
                                android:textColor="?attr/colorOnSurface"
                                android:textIsSelectable="true" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_copy_key"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="@string/storm_sync_copy"
                                android:textSize="11sp"
                                app:icon="@drawable/ic_copy"
                                app:iconSize="14dp"
                                app:cornerRadius="8dp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_server_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storm_sync_server_active"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="3dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Remote Connect Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storm_sync_remote_connect_title"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:layout_marginBottom="4dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <EditText
                                android:id="@+id/edit_remote_key"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:hint="@string/storm_sync_remote_key_hint"
                                android:textSize="11sp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp"
                                android:fontFamily="monospace"
                                android:singleLine="true"
                                android:background="#0D0F18" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_connect"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/storm_sync_btn_connect"
                                android:textSize="11sp"
                                android:layout_marginStart="6dp"
                                app:cornerRadius="8dp" />

                        </LinearLayout>

                        <!-- Local Discovery Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_search_devices"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="@string/storm_sync_btn_search_wifi"
                                android:textSize="10.5sp"
                                app:icon="@drawable/ic_search"
                                app:iconSize="14dp"
                                app:cornerRadius="8dp" />

                            <Spinner
                                android:id="@+id/spinner_discovered"
                                android:layout_width="0dp"
                                android:layout_height="34dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/text_connection_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storm_sync_state_disconnected"
                            android:textSize="10sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="3dp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_sync"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:indeterminate="true"
                            android:visibility="gone"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Right Column: Saves Header + Search + Recycler -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <!-- Section 3 Header & Sync All Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/text_saves_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/storm_sync_saves_count_zero"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sync_all"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="@string/storm_sync_btn_sync_all"
                    android:textSize="10.5sp"
                    app:icon="@drawable/ic_sync"
                    app:iconSize="14dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Search Saves Filter -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_search_saves"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:hint="@string/storm_sync_search_hint"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:layout_marginBottom="6dp"
                android:background="#0D0F18" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_saves"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />

                <TextView
                    android:id="@+id/text_empty_saves"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/storm_sync_empty_saves"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
