/*
 * STORM DARK Stylesheet - Cyber Slate & Electric Cyan Theme
 * Standardized for STORM SWITCH ecosystem
 */

QWidget {
    color: #FFFFFF;
    background-color: #0F172A;
    font-family: "Segoe UI", "Outfit", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 9pt;
    outline: none;
    border: none;
}

QWidget:disabled {
    color: #FFFFFF;
    background-color: #0B1120;
}

QLabel {
    background: transparent;
    background-color: transparent;
    color: #FFFFFF;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: #FFFFFF;
    spacing: 8px;
    padding: 3px;
    font-weight: 500;
}

/* Law 12 & Law 19: Red OFF / Green ON Checkboxes */
QCheckBox::indicator, QGroupBox::indicator, QRadioButton::indicator,
QTreeView::indicator, QTableView::indicator, QListView::indicator, QAbstractItemView::indicator {
    width: 15px;
    height: 15px;
    border-radius: 4px;
    border: 1px solid #EF4444;
    background-color: rgba(239, 68, 68, 0.18);
    image: none;
}
QCheckBox::indicator:hover, QGroupBox::indicator:hover, QRadioButton::indicator:hover,
QTreeView::indicator:hover, QTableView::indicator:hover, QListView::indicator:hover, QAbstractItemView::indicator:hover {
    border-color: #F87171;
    background-color: rgba(239, 68, 68, 0.28);
    image: none;
}
QCheckBox::indicator:unchecked, QGroupBox::indicator:unchecked, QRadioButton::indicator:unchecked,
QTreeView::indicator:unchecked, QTableView::indicator:unchecked, QListView::indicator:unchecked, QAbstractItemView::indicator:unchecked {
    border: 1px solid #EF4444;
    background-color: rgba(239, 68, 68, 0.18);
    border-radius: 4px;
    image: none;
}
QCheckBox::indicator:unchecked:hover, QGroupBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover,
QTreeView::indicator:unchecked:hover, QTableView::indicator:unchecked:hover, QListView::indicator:unchecked:hover, QAbstractItemView::indicator:unchecked:hover {
    border-color: #F87171;
    background-color: rgba(239, 68, 68, 0.28);
    image: none;
}
QCheckBox::indicator:checked, QGroupBox::indicator:checked, QRadioButton::indicator:checked,
QTreeView::indicator:checked, QTableView::indicator:checked, QListView::indicator:checked, QAbstractItemView::indicator:checked {
    background-color: #10B981;
    border: 1px solid #10B981;
    border-radius: 4px;
    image: none;
}
QCheckBox::indicator:checked:hover, QGroupBox::indicator:checked:hover, QRadioButton::indicator:checked:hover,
QTreeView::indicator:checked:hover, QTableView::indicator:checked:hover, QListView::indicator:checked:hover, QAbstractItemView::indicator:checked:hover {
    background-color: #34D399;
    border-color: #34D399;
    image: none;
}
QCheckBox::indicator:disabled, QGroupBox::indicator:disabled, QRadioButton::indicator:disabled,
QTreeView::indicator:disabled, QTableView::indicator:disabled, QListView::indicator:disabled, QAbstractItemView::indicator:disabled {
    border-color: #4B5563;
    background-color: rgba(75, 85, 99, 0.2);
    image: none;
}
QCheckBox::indicator:checked:disabled, QGroupBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled,
QTreeView::indicator:checked:disabled, QTableView::indicator:checked:disabled, QListView::indicator:checked:disabled, QAbstractItemView::indicator:checked:disabled {
    background-color: #065F46;
    border-color: #065F46;
    image: none;
}

QMainWindow, QDialog, QStackedWidget {
    background-color: #0F172A;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    border: none;
    background-color: transparent;
    background: transparent;
}

/* Clean 1px Faceted Buttons (STORM Standard) */
QPushButton,
QDialogButtonBox QPushButton,
QToolButton,
QCommandLinkButton,
QWizard QPushButton,
QMessageBox QPushButton,
QPushButton[flat="true"],
QToolButton[flat="true"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #25354e, stop:1 #0f172a);
    color: #FFFFFF;
    border: 1px solid #2a3b55;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 600;
    min-height: 22px;
}

QPushButton:hover,
QDialogButtonBox QPushButton:hover,
QToolButton:hover,
QCommandLinkButton:hover,
QWizard QPushButton:hover,
QMessageBox QPushButton:hover,
QPushButton[flat="true"]:hover,
QToolButton[flat="true"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #334664, stop:1 #131c2c);
    border: 1px solid #38bdf8;
    color: #38bdf8;
}

QPushButton:pressed,
QDialogButtonBox QPushButton:pressed,
QToolButton:pressed,
QCommandLinkButton:pressed,
QWizard QPushButton:pressed,
QMessageBox QPushButton:pressed,
QPushButton[flat="true"]:pressed,
QToolButton[flat="true"]:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0d1522, stop:1 #1a283e);
    border: 1px solid #38bdf8;
    padding: 7px 15px 5px 17px;
    color: #FFFFFF;
}

QPushButton:checked,
QDialogButtonBox QPushButton:checked,
QToolButton:checked,
QCommandLinkButton:checked,
QWizard QPushButton:checked,
QMessageBox QPushButton:checked,
QPushButton[flat="true"]:checked,
QToolButton[flat="true"]:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #334664, stop:1 #131c2c);
    border: 1px solid #38bdf8;
    color: #FFFFFF;
}

QPushButton:focus,
QDialogButtonBox QPushButton:focus,
QToolButton:focus,
QCommandLinkButton:focus,
QWizard QPushButton:focus,
QMessageBox QPushButton:focus {
    border: 1px solid #38bdf8;
}

QPushButton:disabled,
QDialogButtonBox QPushButton:disabled,
QToolButton:disabled,
QCommandLinkButton:disabled,
QWizard QPushButton:disabled,
QMessageBox QPushButton:disabled,
QPushButton[flat="true"]:disabled,
QToolButton[flat="true"]:disabled {
    background-color: #0c1322;
    color: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 6px 16px;
}

QPushButton:default,
QDialogButtonBox QPushButton:default,
QToolButton:default,
QCommandLinkButton:default,
QWizard QPushButton:default,
QMessageBox QPushButton:default,
QPushButton[primary="true"],
QToolButton[primary="true"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #38bdf8, stop:1 #0284c7);
    color: #FFFFFF;
    border: 1px solid #0284c7;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 700;
    min-height: 22px;
}

QPushButton:default:hover,
QDialogButtonBox QPushButton:default:hover,
QToolButton:default:hover,
QCommandLinkButton:default:hover,
QWizard QPushButton:default:hover,
QMessageBox QPushButton:default:hover,
QPushButton[primary="true"]:hover,
QToolButton[primary="true"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #7dd3fc, stop:1 #0ea5e9);
    border: 1px solid #7dd3fc;
    color: #FFFFFF;
}

QPushButton:default:pressed,
QDialogButtonBox QPushButton:default:pressed,
QToolButton:default:pressed,
QCommandLinkButton:default:pressed,
QWizard QPushButton:default:pressed,
QMessageBox QPushButton:default:pressed,
QPushButton[primary="true"]:pressed,
QToolButton[primary="true"]:pressed {
    background-color: #0369a1;
    border: 1px solid #075985;
    padding: 7px 15px 5px 17px;
    color: #FFFFFF;
}

QToolButton:disabled {
    background-color: #0B1120;
    color: #FFFFFF;
    border-color: #1E293B;
}

/* ToolBars */
QToolBar {
    background-color: #152033;
    border-bottom: 1px solid #1E293B;
    padding: 4px;
    spacing: 6px;
}

/* Inputs */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0B1120;
    color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 6px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 10px;
    padding-right: 28px;
    selection-background-color: #00D2FF;
    selection-color: #0F172A;
    min-height: 32px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1.5px solid #00D2FF;
    background-color: #0F172A;
}

/* Combo Box */
QComboBox {
    background-color: #0B1120;
    color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 6px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 10px;
    padding-right: 28px;
    min-height: 32px;
    min-width: 6em;
}

QComboBox:hover {
    border-color: #00D2FF;
}

QComboBox:on {
    border-color: #00D2FF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #334155;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 6px;
    selection-background-color: #00D2FF;
    selection-color: #0F172A;
    padding: 4px;
}

/* Tab Widget & Tab Bar */
QTabWidget::pane {
    border: 1px solid #334155;
    background-color: #0F172A;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background-color: #152033;
    color: #FFFFFF;
    border: 1px solid #334155;
    border-bottom: none;
    padding: 8px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 3px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #0F172A;
    color: #00D2FF;
    border-color: #00D2FF;
    border-bottom: 2px solid #0F172A;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    background-color: #1E293B;
    color: #FFFFFF;
    border-color: #FFFFFF;
}

QListWidget#selectorList {
    background-color: #0F172A;
    border-right: 1px solid #1E293B;
    font-weight: 600;
    font-size: 9.5pt;
}

QListWidget#selectorList::item {
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 6px;
    margin: 2px 4px;
    color: #FFFFFF;
}

QListWidget#selectorList::item:hover {
    background-color: rgba(0, 210, 255, 0.12);
    color: #00D2FF;
}

QListWidget#selectorList::item:selected {
    background-color: rgba(0, 210, 255, 0.22);
    border-left: 3px solid #00D2FF;
    color: #FFFFFF;
    font-weight: 700;
}

/* Tree & List Views (Game List) */
QTreeView, QListView, QTableView {
    background-color: #0F172A;
    alternate-background-color: #131D31;
    color: #FFFFFF;
    border: 1px solid #1E293B;
    border-radius: 6px;
    gridline-color: #1E293B;
    selection-background-color: rgba(0, 210, 255, 0.25);
    selection-color: #FFFFFF;
    outline: none;
}

QTreeView::item, QListView::item, QTableView::item {
    padding: 6px 10px;
    border-right: 1px solid #1A2338;
    border-bottom: 1px solid #1A2338;
}

QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: rgba(0, 210, 255, 0.15);
    color: #00D2FF;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: rgba(0, 210, 255, 0.32);
    color: #FFFFFF;
    font-weight: bold;
}

QHeaderView::section {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1E293B, stop:1 #152033);
    color: #00D2FF;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid #334155;
    border-bottom: 2px solid #00D2FF;
    font-weight: 800;
    font-size: 8.5pt;
    text-align: center;
}

/* Status Bar & Footer */
QStatusBar {
    background-color: #152033;
    border-top: 1px solid #1E293B;
    color: #FFFFFF;
    padding: 2px 4px;
}

QStatusBar::item {
    border: none;
}

/* Status Bar Group Container */
QWidget#StatusBarGroup {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 5px;
    margin: 1px;
}

QWidget#StatusBarGroup:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(0, 210, 255, 0.4);
}

QLabel#StatusBarGroupLabel {
    background: transparent;
    font-weight: 900;
    font-size: 7.2pt;
    letter-spacing: 1.2px;
}

/* Status Bar Buttons */
QPushButton#TogglableStatusBarButton,
QPushButton#RendererStatusBarButton,
QPushButton#GPUStatusBarButton,
QPushButton#DockingStatusBarButton,
QPushButton#RefreshButton,
QPushButton#VolumeButton,
QStatusBar QPushButton,
QPushButton#StatusBarGroupLabel {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #25354e, stop:1 #162030);
    color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 800;
    min-height: 26px;
}

QPushButton#TogglableStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover,
QPushButton#GPUStatusBarButton:hover,
QPushButton#DockingStatusBarButton:hover,
QPushButton#VolumeButton:hover,
QStatusBar QPushButton:hover,
QPushButton#StatusBarGroupLabel:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #334664, stop:1 #1e293b);
    border-color: #38bdf8;
    color: #38bdf8;
}

QPushButton#TogglableStatusBarButton:pressed,
QPushButton#RendererStatusBarButton:pressed,
QPushButton#GPUStatusBarButton:pressed,
QPushButton#DockingStatusBarButton:pressed,
QPushButton#VolumeButton:pressed,
QStatusBar QPushButton:pressed,
QPushButton#StatusBarGroupLabel:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0f172a, stop:1 #25354e);
    border-color: #38bdf8;
    padding: 4px 7px 2px 9px;
    color: #FFFFFF;
}

QPushButton#TogglableStatusBarButton:checked,
QPushButton#RendererStatusBarButton:checked,
QPushButton#GPUStatusBarButton:checked,
QPushButton#DockingStatusBarButton:checked,
QPushButton#VolumeButton:checked,
QStatusBar QPushButton:checked,
QPushButton#StatusBarGroupLabel:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #334664, stop:1 #1e293b);
    border-color: #38bdf8;
    color: #FFFFFF;
}

QPushButton#RefreshButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(0, 230, 118, 0.25), stop:1 rgba(0, 200, 83, 0.15));
    color: #00e676;
    border: 1px solid #00e676;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 8pt;
    font-weight: 800;
    min-height: 26px;
}

QPushButton#RefreshButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #00e676, stop:1 #00c853);
    border: 1px solid #69f0ae;
    color: #FFFFFF;
}

QPushButton#RefreshButton:pressed {
    background-color: #00a844;
    border: 1px solid #008f3a;
    padding: 4px 7px 2px 9px;
    color: #FFFFFF;
}

/* Status Bar Labels Hover */
QStatusBar QLabel:hover,
QLabel#FirmwareLabel:hover,
QLabel#TASlabel:hover,
ClickableLabel:hover {
    color: #00D2FF;
    background-color: rgba(0, 210, 255, 0.12);
    border-radius: 3px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #2a244d;
    min-height: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00D2FF;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 7px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #2a244d;
    min-width: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00D2FF;
}

/* Progress Bar */
QProgressBar {
    background-color: #0B1120;
    border: 1px solid #334155;
    border-radius: 6px;
    text-align: center;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0099FF, stop:1 #00D2FF);
    border-radius: 5px;
}

/* Group Boxes */
QGroupBox {
    border: 1px solid #334155;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 14px;
    background-color: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #00D2FF;
    font-weight: 700;
    background-color: transparent;
}

QGroupBox QWidget,
QGroupBox QLabel,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    background: transparent;
    background-color: transparent;
}

QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background: transparent;
    background-color: transparent;
}

/* ToolTip */
QToolTip {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 1px solid #00D2FF;
    border-radius: 6px;
    padding: 6px 10px;
}

/* Menus & MenuBar */
QMenuBar {
    background-color: #152033;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 9.5pt;
    padding: 3px 6px;
    border-bottom: 1px solid #1E293B;
}

QMenuBar::item {
    background-color: transparent;
    color: #FFFFFF;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 5px;
    margin-right: 4px;
}

QMenuBar::item:selected, QMenuBar::item:hover {
    background-color: rgba(0, 210, 255, 0.18);
    color: #00D2FF;
}

QMenuBar::item:pressed {
    background-color: #00D2FF;
    color: #0F172A;
}

QMenu {
    background-color: #152033;
    color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 6px;
    min-width: 140px;
}

QMenu::item {
    padding: 6px 22px 6px 22px;
    border-radius: 5px;
    margin: 2px 4px;
    font-weight: 600;
    font-size: 9pt;
}

QMenu::item:selected {
    background-color: #00D2FF;
    color: #0F172A;
    font-weight: 700;
}

QMenu::item:disabled {
    color: #FFFFFF;
    background-color: transparent;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::separator {
    height: 1px;
    background-color: #334155;
    margin: 4px 8px;
}

/* QSlider Styling - STORM DARK */
QSlider {
    min-height: 24px;
    background: transparent;
}

QSlider::groove:horizontal {
    border: 1px solid #334155;
    height: 6px;
    background: #0B1120;
    margin: 2px 0;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #0099FF, stop:1 #00D2FF);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #1E293B;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #FFFFFF, stop:1.0 #00D2FF);
    border: 2px solid #00D2FF;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border: 2px solid #38BDF8;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:pressed {
    background: #00D2FF;
    border: 2px solid #FFFFFF;
}

QSlider::handle:horizontal:disabled {
    background: #334155;
    border: 2px solid #1E293B;
}

QSlider::groove:vertical {
    border: 1px solid #334155;
    width: 6px;
    background: #0B1120;
    margin: 0 2px;
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background: #1E293B;
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #38BDF8, stop:1 #00D2FF);
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0.5 #FFFFFF, stop:1.0 #00D2FF);
    border: 2px solid #00D2FF;
    width: 16px;
    height: 16px;
    margin: 0 -6px;
    border-radius: 8px;
}

QSlider::handle:vertical:hover {
    background: #FFFFFF;
    border: 2px solid #38BDF8;
    width: 18px;
    height: 18px;
    margin: 0 -7px;
    border-radius: 9px;
}

QSlider::handle:vertical:pressed {
    background: #00D2FF;
    border: 2px solid #FFFFFF;
}


/* STORM STRUCTURED UI RULES - STORM_DARK */

/* Structured Recessed Search Capsule (Law 17 & 23) */
QLineEdit#SettingsSearchEdit,
QLineEdit[stormSearchBox="true"] {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 8px;
    padding: 6px 14px;
    color: #ffffff;
    font-size: 12.5px;
    min-height: 32px;
}
QLineEdit#SettingsSearchEdit:focus,
QLineEdit[stormSearchBox="true"]:focus {
    border: 1px solid #00F0FF;
    background-color: rgba(255, 255, 255, 0.09);
}

/* Volumetric Sculpted Section Cards (QGroupBox) */
QGroupBox[stormCard="true"],
QGroupBox#groupBox[stormHeroCard="true"],
QGroupBox#BentoGameHeaderCard {
    background-color: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 10px;
    margin-top: 14px;
    padding: 24px 14px 14px 14px;
}
QGroupBox[stormCard="true"]::title,
QGroupBox#groupBox[stormHeroCard="true"]::title,
QGroupBox#BentoGameHeaderCard::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 2px 10px;
    color: #00F0FF;
    font-size: 12px;
    font-weight: bold;
    background-color: #0F172A;
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 4px;
}

/* Recessed 3D Inputs, SpinBoxes & Dropdowns (Law 17/23) */
QLineEdit[stormCapsule="true"],
QSpinBox[stormCapsule="true"],
QDoubleSpinBox[stormCapsule="true"],
QComboBox[stormCapsule="true"] {
    min-height: 32px;
    border-radius: 6px;
    padding: 4px 10px;
}

/* Per-Game Override Row Accent Highlight */
QWidget[stormOverrideRow="true"],
ConfigurationShared--Widget[stormOverrideRow="true"] {
    border-left: 3px solid #00F0FF;
    background-color: rgba(0, 240, 255, 0.07);
    border-radius: 4px;
}

/* Clean 1px Faceted Reset Custom Settings Button */
QPushButton#ResetPerGameHeroButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ef4444, stop:1 #b91c1c);
    color: #FFFFFF;
    border: 1px solid #dc2626;
    border-radius: 7px;
    padding: 6px 14px;
    font-weight: bold;
    font-size: 11.5px;
    min-height: 30px;
}
QPushButton#ResetPerGameHeroButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f87171, stop:1 #dc2626);
    border: 1px solid #fca5a5;
}
QPushButton#ResetPerGameHeroButton:pressed {
    background: #991b1b;
    border: 1px solid #7f1d1d;
    padding: 6px 14px;
}

/* Recessed 3D Status Bar Telemetry Capsules (Law 20) */
QWidget[stormStatusCapsule="true"],
QWidget#StatusBarGroup {
    border-radius: 6px;
    margin: 1px 2px;
    padding: 1px 3px;
}
QWidget[stormStatusCapsule="true"]:hover,
QWidget#StatusBarGroup:hover {
    border-color: #00F0FF;
}

/* Visible 1px Vertical Column Dividers in All Tables (Law 12) */
QTableView[stormTable="true"]::item,
QTreeView[stormTable="true"]::item,
QTableWidget[stormTable="true"]::item,
QTreeWidget[stormTable="true"]::item {
    border-right: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    padding: 6px 10px;
}
QHeaderView::section {
    border-right: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

QSpinBox QLineEdit, QDoubleSpinBox QLineEdit {
    padding: 0px;
    margin: 0px;
    border: none;
    background: transparent;
}

/* --- STORM SWITCH Structured UI & Status Bar Rules --- */
QLineEdit#SettingsSearchEdit,
QLineEdit#HotkeysSearchEdit,
QLineEdit[stormSearchBox="true"] {
    background-color: #0F172A;
    border: 1px solid rgba(0, 210, 255, 0.35);
    border-radius: 7px;
    padding: 6px 12px;
    color: #FFFFFF;
    font-size: 12.5px;
    margin-bottom: 4px;
}
QLineEdit#SettingsSearchEdit:focus,
QLineEdit#HotkeysSearchEdit:focus,
QLineEdit[stormSearchBox="true"]:focus {
    border: 1px solid #00F0FF;
    background-color: #162032;
}

QListWidget#SettingsSearchResultsList {
    background-color: #0B1325;
    border: 1px solid #00F0FF;
    border-radius: 7px;
    padding: 4px;
    color: #FFFFFF;
    font-size: 12px;
    margin-bottom: 6px;
    outline: none;
}
QListWidget#SettingsSearchResultsList::item {
    padding: 6px 10px;
    border-radius: 5px;
    margin: 1px 0px;
}
QListWidget#SettingsSearchResultsList::item:hover {
    background-color: rgba(0, 240, 255, 0.16);
    color: #FFFFFF;
}
QListWidget#SettingsSearchResultsList::item:selected {
    background-color: rgba(0, 240, 255, 0.26);
    border-left: 3px solid #00F0FF;
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#ShaderBuildingLabel[compiling="true"] {
    background-color: rgba(255, 64, 129, 0.12);
    color: #ff4081;
    border: 1px solid rgba(255, 64, 129, 0.35);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QLabel#EmuSpeedLabel {
    background-color: rgba(0, 230, 118, 0.10);
    color: #00e676;
    border: 1px solid rgba(0, 230, 118, 0.30);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QLabel#GameFpsLabel {
    background-color: rgba(0, 229, 255, 0.10);
    color: #00e5ff;
    border: 1px solid rgba(0, 229, 255, 0.30);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QLabel#EmuFrametimeLabel {
    background-color: rgba(255, 202, 40, 0.10);
    color: #ffca28;
    border: 1px solid rgba(255, 202, 40, 0.30);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 7.2pt;
    font-weight: 700;
}

QListWidget#PerGameSelectorList,
QListWidget[stormList="true"] {
    background-color: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    outline: none;
    padding: 4px;
}
QListWidget#PerGameSelectorList::item,
QListWidget[stormList="true"]::item {
    padding: 8px 12px;
    border-radius: 5px;
    margin: 2px 0px;
    color: #E2E8F0;
    font-weight: 600;
}
QListWidget#PerGameSelectorList::item:hover,
QListWidget[stormList="true"]::item:hover {
    background-color: rgba(0, 240, 255, 0.15);
    color: #00F0FF;
}
QListWidget#PerGameSelectorList::item:selected,
QListWidget[stormList="true"]::item:selected {
    background-color: rgba(0, 240, 255, 0.25);
    border-left: 3px solid #00F0FF;
    color: #00F0FF;
}

QGroupBox#BentoGameHeaderCard,
QGroupBox[stormHeroCard="true"] {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.30);
    border-radius: 10px;
    padding: 10px;
}
