<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A607050F"
    android:paddingHorizontal="16dp"
    android:paddingVertical="20dp">

    <!-- Flagship Sculpted Dark Glassmorphic Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/storm_dialog_card_bg"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/storm_tile_3d_recessed"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/image_profiles_header_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_folder_open"
                    app:tint="#C084FC" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_profiles_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_profiles_title"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <!-- Counter pill -->
                    <TextView
                        android:id="@+id/text_profiles_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_storm_badge_capsule"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="0"
                        android:textColor="#38BDF8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_profiles_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/settings_profiles_description"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:maxLines="2" />
            </LinearLayout>

            <!-- Faceted 3D Close Button -->
            <ImageView
                android:id="@+id/btn_close_profiles"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:padding="9dp"
                android:background="@drawable/bg_storm_circle_button"
                android:src="@drawable/ic_clear"
                app:tint="#CBD5E1"
                android:contentDescription="@string/close" />

        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#258B5CF6"
            android:layout_marginBottom="12dp" />

        <!-- Top Action Bar: 3D Faceted Convex Buttons (Zero abbreviation, Zero truncation) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_current_profile"
                style="@style/StormButton.3D.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
            android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/profile_btn_save_current"
                android:textSize="13sp"
                app:icon="@drawable/ic_add"
                app:iconTint="#FFFFFF"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_profile"
                style="@style/StormButton.3D.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
            android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/profile_btn_import"
                android:textSize="13sp"
                app:icon="@drawable/ic_folder_open"
                app:iconTint="#CBD5E1"
                app:iconSize="18dp" />

        </LinearLayout>

        <!-- List of Profile Cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_profiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="8dp" />

    </LinearLayout>

</FrameLayout>
