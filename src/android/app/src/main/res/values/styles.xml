    </style>

    <!-- Eden theme styles -->
    <style name="EdenSlider" parent="Widget.Material3.Slider">
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorOutline</item>
        <item name="thumbColor">?attr/colorSecondary</item>
        <item name="haloColor">?attr/colorSecondary</item>
    </style>

    <style name="StormShape.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="StormDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">#00F0FF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StormDialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#CBD5E1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
    </style>

    <style name="StormButton.Dialog.Positive" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">#00F0FF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">#16263D</item>
        <item name="strokeColor">#00D2FF</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="StormButton.Dialog.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#94A3B8</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="StormButton.Dialog.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#F59E0B</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="EdenMaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/StormDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/StormDialog.Body</item>
        <item name="android:textColorAlertDialogListItem">#F1F5F9</item>
        <item name="singleChoiceItemLayout">@layout/storm_alert_dialog_singlechoice</item>
        <item name="multiChoiceItemLayout">@layout/storm_alert_dialog_multichoice</item>
        <item name="listItemLayout">@layout/storm_alert_dialog_item</item>
        <item name="buttonBarPositiveButtonStyle">@style/StormButton.Dialog.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/StormButton.Dialog.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/StormButton.Dialog.Neutral</item>
        <item name="shapeAppearance">@style/StormShape.Dialog</item>
        <item name="shapeAppearanceOverlay">@style/StormShape.Dialog</item>
        <item name="colorSurface">#0F172A</item>
        <item name="colorOnSurface">#F1F5F9</item>
        <item name="colorSurfaceVariant">#1E293B</item>
        <item name="colorOnSurfaceVariant">#94A3B8</item>
        <item name="colorPrimary">#00D2FF</item>
        <item name="colorSecondary">#00F0FF</item>
        <item name="colorOutline">#20354E</item>
        <item name="dialogCornerRadius">18dp</item>
        <item name="backgroundTint">#0F172A</item>
        <item name="android:windowBackground">@drawable/dialog_background_storm</item>
    </style>

    <style name="EdenButton.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.Eden.TransparentTopAppBarLayout" parent="">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="liftOnScroll">false</item>
        <item name="statusBarForeground">@android:color/transparent</item>
    </style>

    <style name="Widget.Eden.TransparentTopToolbar" parent="">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="EdenPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
    </style>
    <style name="YuzuPopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
    </style>

    <style name="EdenButton.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/eden_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="backgroundTint">@color/eden_primary</item>
    </style>

    <style name="EdenButton.Filled" parent="Widget.Material3.Button">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="EdenButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/eden_secondary</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/eden_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="EdenButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="EdenCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="EdenGameCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="EdenCardElevated" parent="">
        <item name="android:background">@drawable/eden_card_elevated_selector</item>
        <item name="android:elevation">0dp</item>
        <item name="android:padding">16dp</item>
    </style>
    <!-- Gothic / STORM Text Styles -->
    <style name="SynthwaveText.Title" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
    <style name="SynthwaveText.Header" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="SynthwaveText.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="SynthwaveText.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="SynthwaveText.Accent" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    <!-- Shape appearance for carousel images -->
    <style name="ShapeAppearance.Eden.CarouselImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
