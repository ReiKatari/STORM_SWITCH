<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0E17"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_sync"
            app:tint="#00F0FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Разрешение конфликта сохранений"
                android:textColor="#00F0FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_conflict_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                tools:text="Игра: Assassin's Creed: The Rebel Collection [010044700DEB0000]" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="На текущем и удалённом устройствах обнаружены разные версии сохранения. Сравните время создания и выберите действие."
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <!-- Cards container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <!-- Local Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#141C2B"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:strokeColor="#20354E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/text_local_device_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Текущее устройство (Телефон)"
                    android:textColor="#00F0FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_local_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="📅 Дата и время: 14.09.2026 13:30" />

                <TextView
                    android:id="@+id/text_local_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    tools:text="📦 Размер данных: 1.42 МБ • Файлов: 6" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Remote Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#141C2B"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:strokeColor="#20354E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/text_remote_device_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Удалённое устройство (ПК)"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_remote_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="📅 Дата и время: 14.09.2026 13:35" />

                <TextView
                    android:id="@+id/text_remote_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    tools:text="📦 Размер данных: 1.50 МБ • Файлов: 6" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_replace_current"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Заменить текущее"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#1B2B44"
            app:strokeColor="#00D2FF"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_replace_remote"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:text="Заменить на удалённом"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:backgroundTint="#162030"
            app:strokeColor="#3B82F6"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_keep_both"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:text="Сохранить оба варианта"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#00F0FF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_conflict"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:text="Отмена"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
