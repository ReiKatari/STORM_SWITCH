<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_control"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#CC172033"
    app:strokeColor="#3000D2FF"
    app:strokeWidth="1dp"
    app:rippleColor="#4000D2FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Control Glyph / Icon Frame -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/badge_pill_cyan"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/text_control_glyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#00F0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/icon_control"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_controller"
                app:tint="#00F0FF"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_control_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Кнопка A"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_control_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Основная кнопка действия"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            app:thumbTint="#00F0FF"
            app:trackTint="#3300D2FF" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
