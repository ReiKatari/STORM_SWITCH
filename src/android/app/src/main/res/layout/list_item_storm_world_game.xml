<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#161B26"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeColor="#20354E"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_game_cover"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@drawable/default_icon"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_game_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Diablo III: Eternal Collection" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_game_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_pill_background"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textColor="#00D2FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="v1.0.9" />

                <TextView
                    android:id="@+id/text_game_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    tools:text="15.8 GB" />

                <TextView
                    android:id="@+id/text_game_langs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    tools:text="RU, EN" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_game_serial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="#64748B"
                android:textSize="10sp"
                tools:text="01001B700A654000" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_download_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="✅ Скачано" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>